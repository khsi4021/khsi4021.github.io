---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, hasEmail, hasLinkedIn } from "@/data/site";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Khalil Sidani about graduate research, internships or engineering roles."
>
  <section class="wrap pt-12 md:pt-16">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3 text-[clamp(2rem,4.5vw,3rem)]">Get in touch</h1>
    <p class="mt-4 max-w-[60ch] text-lg text-muted">
      I'm applying to graduate programs for Fall 2027 and I'm open to internships and industry roles in aerodynamics,
      hypersonics and simulation. Email is the best way to reach me.
    </p>
    <ul class="mt-10 grid max-w-3xl gap-4 sm:grid-cols-3">
      <li class="card p-5">
        <p class="mono-label">Email</p>
        {hasEmail ? (
          <a class="mt-1 block break-all text-flow underline underline-offset-2" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        ) : (
          <p class="mt-1 text-muted">Address coming soon</p>
        )}
      </li>
      <li class="card p-5">
        <p class="mono-label">LinkedIn</p>
        {hasLinkedIn ? (
          <a class="mt-1 block text-flow underline underline-offset-2" href={site.linkedin} rel="me">
            Profile ↗
          </a>
        ) : (
          <p class="mt-1 text-muted">Link coming soon</p>
        )}
      </li>
      <li class="card p-5">
        <p class="mono-label">GitHub</p>
        <a class="mt-1 block text-flow underline underline-offset-2" href={site.github} rel="me">
          @{site.githubUser} ↗
        </a>
      </li>
    </ul>
    {/* TODO(Lilo): set email and LinkedIn in src/data/site.ts */}
  </section>
</BaseLayout>
