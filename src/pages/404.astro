---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="Page not found.">
  <section class="wrap grid min-h-[55vh] place-items-center py-20 text-center">
    <div>
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl">This trajectory didn't converge.</h1>
      <p class="mt-4 text-muted">The page you're looking for isn't here.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">
          Home
        </a>
        <a href="/projects/" class="btn">
          Projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
