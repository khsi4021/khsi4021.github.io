---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PathFlow from "@/components/PathFlow.astro";
import type { PathFlowItem } from "@/components/PathFlow.astro";

// Title, link and date only. The descriptive sentences were removed with the rest of the draft prose.
// kind drives the block colour: course = neutral, personal = accent wash, goal = accent fill.
const path: PathFlowItem[] = [
  {
    when: "Fall 2024 · ASEN 2012",
    title: "First simulations: ODE models with uncertainty",
    href: "/projects/bottle-rocket/",
    kind: "course",
  },
  {
    when: "Spring 2026 · APPM 3050",
    title: "Finite differences for PDEs",
    href: "/projects/tsunami-simulation/",
    kind: "course",
  },
  {
    when: "Spring 2026 · ASEN 3802",
    title: "Panel methods and lifting-line theory",
    href: "/coursework/#computational-aero",
    kind: "course",
  },
  {
    when: "Aug 2026 · Personal",
    title: "Hypersonic boundary-layer and transition solver",
    href: "/projects/hypersonic-solver/",
    kind: "personal",
  },
  {
    when: "Fall 2026 · ASEN 5131",
    title: "Graduate hypersonic aerodynamics",
    href: "/coursework/#hypersonics",
    kind: "course",
  },
  {
    when: "Fall 2027 · Goal",
    title: "Graduate research in CFD for hypersonic flows",
    kind: "goal",
    todo: true,
  },
];
---

<BaseLayout
  title="Research interests"
  description="Research interests of Khalil Sidani: computational fluid dynamics for hypersonic flows, and the projects that lead toward it."
>
  <!-- TODO(Khalil): every block marked "placeholder" on this page is waiting for your own wording.
       The h1 is also draft copy; keep it or replace it. -->
  <article class="wrap pt-10 md:pt-14">
    <header class="mb-10">
      <p class="eyebrow">Research interests</p>
      <h1 class="mt-2 max-w-[28ch] text-[clamp(1.75rem,4vw,2.375rem)]">
        Predicting heating and transition on hypersonic vehicles, and knowing how far to trust the prediction
      </h1>
      <div class="placeholder mt-6 max-w-[60ch]" data-placeholder>
        <p>A short statement of the research direction I want to pursue will go here.</p>
      </div>
    </header>

    <section class="sec" aria-labelledby="questions-h">
      <h2 id="questions-h" class="sec-label">
        <span class="n">1</span>Questions that interest me
      </h2>
      <div class="max-w-[68ch]">
        <div class="placeholder" data-placeholder>
          <p>A list of the research questions I want to work on will go here.</p>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="bring-h">
      <h2 id="bring-h" class="sec-label">
        <span class="n">2</span>What I bring
      </h2>
      <div class="max-w-[68ch]">
        <div class="placeholder" data-placeholder>
          <p>A summary of the skills and results I bring to a research group will go here.</p>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="path-h">
      <h2 id="path-h" class="sec-label">
        <span class="n">3</span>How the projects build toward it
      </h2>
      <div>
        <PathFlow items={path} label="Steps from early coursework to the graduate research goal" />
        <div class="placeholder mt-6 max-w-[68ch]" data-placeholder>
          <p>A sentence on what each step added will go with each block above.</p>
        </div>
        <p class="mt-6 font-sans text-sm">
          <a href="/projects/">All projects</a>
        </p>
      </div>
    </section>

    <section class="sec" aria-labelledby="next-h">
      <h2 id="next-h" class="sec-label">
        <span class="n">4</span>What I want to learn next
      </h2>
      <div class="max-w-[68ch]">
        <div class="placeholder" data-placeholder>
          <p>A paragraph on the methods and tools I want to learn next will go here.</p>
        </div>
      </div>
    </section>

    <section id="schools" class="sec scroll-mt-8" aria-labelledby="schools-h">
      <h2 id="schools-h" class="sec-label">
        <span class="n">5</span>Program and lab notes
      </h2>
      <div class="max-w-[68ch]">
        <!-- TODO(Khalil): add per-school entries, or remove this section. -->
        <div class="placeholder" data-placeholder>
          <p>Notes on specific programs, labs and advisors will go here.</p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
