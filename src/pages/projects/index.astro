---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectGrid from "@/components/ProjectGrid.astro";
import PackReveal from "@/components/PackReveal.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="Hypersonics, CFD and numerical methods, flight dynamics, orbital safety and aircraft design projects by Khalil Sidani."
>
  <header class="wrap pt-10 pb-8 md:pt-14">
    <h1 class="text-[clamp(1.75rem,4vw,2.375rem)]">Projects</h1>
    <p class="mt-4 max-w-[60ch] text-lg text-muted">
      Each project page has the same tabs: <strong class="text-ink">Overview</strong>,{" "}
      <strong class="text-ink">Technical</strong>, <strong class="text-ink">Results</strong>,{" "}
      <strong class="text-ink">Reflection</strong> and <strong class="text-ink">Code</strong>. The label on each card
      says whether it was personal, course or team work.
    </p>
  </header>
  <section class="wrap pb-8">
    <ProjectGrid projects={projects} />
  </section>
  <PackReveal />
</BaseLayout>
