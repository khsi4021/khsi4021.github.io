---
import "katex/dist/katex.min.css";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectTabs from "@/components/ProjectTabs.astro";
import TabPanel from "@/components/TabPanel.astro";
import MetaSidebar from "@/components/MetaSidebar.astro";
import Figure from "@/components/Figure.astro";
import Equation from "@/components/Equation.astro";
import CodeSnippet from "@/components/CodeSnippet.astro";
import Callout from "@/components/Callout.astro";
import Video from "@/components/Video.astro";
import Lightbox from "@/components/Lightbox.astro";
import EncounterViewer from "@/components/EncounterViewer.astro";
import PoleMap from "@/components/PoleMap.astro";
import TypeBadge from "@/components/TypeBadge.astro";
import { nbHyphen } from "@/utils/text";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((p, i) => ({
    params: { slug: p.data.slug },
    props: { project: p, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const components = { TabPanel, Figure, Equation, CodeSnippet, Callout, Video, EncounterViewer, PoleMap };
---

<BaseLayout title={d.title} description={d.summary} ogImage={d.heroImage} ogAlt={d.heroAlt} type="article">
  <article class="wrap pt-8 md:pt-12">
    <nav aria-label="Breadcrumb" class="mono-label no-print">
      <a href="/projects/" class="underline underline-offset-2 hover:text-ink">
        Projects
      </a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{d.title}</span>
    </nav>

    <header class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)]">
      <div class="tile flex flex-col justify-between gap-6 md:!p-8">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-sm text-muted">
          <TypeBadge type={d.type} context={d.context} />
          {d.course && <span>{d.course}</span>}
          <span>{d.dates}</span>
        </p>
        <div>
          <h1 class="text-[clamp(1.75rem,4vw,2.375rem)] leading-[1.15]">{nbHyphen(d.title)}</h1>
          <p class="mt-3 max-w-[60ch] text-lg text-muted">{d.hook}</p>
        </div>
      </div>
      <div class="tile flex flex-col md:!p-8">
        <p class="font-sans text-sm font-semibold text-ink">TL;DR</p>
        <p class="mt-2 text-[1.0625rem] leading-relaxed">{d.tldr}</p>
      </div>
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
      <div class="min-w-0">
        <ProjectTabs tabs={d.tabs}>
          <Content components={components} />
        </ProjectTabs>
      </div>
      <div class="order-first lg:order-none">
        <div class="lg:sticky lg:top-[4.5rem]">
          <MetaSidebar project={project} />
        </div>
      </div>
    </div>

    <nav class="no-print mt-16 grid gap-x-8 border-t border-line font-sans sm:grid-cols-2" aria-label="More projects">
      {prev ? (
        <a href={`/projects/${prev.data.slug}/`} class="pn-link">
          <span class="mono-label block">Previous</span>
          <span class="pn-title">{nbHyphen(prev.data.title)}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={`/projects/${next.data.slug}/`} class="pn-link sm:text-right">
          <span class="mono-label block">Next</span>
          <span class="pn-title">{nbHyphen(next.data.title)}</span>
        </a>
      )}
    </nav>
  </article>
  <Lightbox />
</BaseLayout>

<style>
  .pn-link {
    display: block;
    padding-block: 1rem;
    text-decoration: none;
  }
  .pn-title {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }
  .pn-link:hover .pn-title {
    color: var(--flow);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
