---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { flowVis } from "@/data/flowvis";
---

<BaseLayout
  title="Flow Visualization"
  description="Photographs and videos from ATLS 5151 Flow Visualization: Marangoni flow in milk, Chladni patterns, a torch flame on crème brûlée and a green flame."
>
  <div class="wrap pt-10 pb-16 md:pt-12">
    <header class="pb-7">
      <p class="eyebrow">ATLS 5151, Fall 2026</p>
      <h1 class="mt-2 text-[clamp(1.75rem,4vw,2.375rem)]">Flow Visualization</h1>
      <p class="mt-4 max-w-[76ch] text-lg text-muted">
        These are my images and videos from ATLS 5151 Flow Visualization, a graduate course at the University of
        Colorado Boulder. Each assignment is a photograph or video of a real flow, with a written report on the physics
        and the technique. I have also gone a step further in this class and developed CFD models for the different
        projects. The descriptions are taken from my reports. The images are also posted on
        <a href="https://www.flowvis.org/">flowvis.org</a>.
      </p>
      {/* TODO(Khalil): add the CFD results for each piece (figures, what was modelled, which solver). */}
    </header>

    <ul class="showcase" aria-label="Flow visualization pieces">
      {flowVis.map((p, i) => (
        <li>
          <a class="piece" href={`/flow-vis/${p.slug}/`} aria-labelledby={`${p.id}-t`} aria-describedby={`${p.id}-d`}>
            <span class="piece-plate">
              <Image
                src={p.media.image}
                alt={p.alt}
                widths={[360, 540, 720, 1080]}
                sizes="(min-width: 1024px) 25vw, (min-width: 600px) 50vw, 100vw"
                format="webp"
                loading={i < 2 ? "eager" : "lazy"}
              />
              {p.media.kind !== "photo" && <span class="piece-kind">Video</span>}
            </span>
            <span class="piece-text">
              <span class="piece-meta">
                <span class="n">{i + 1}</span>
                {p.assignment}
              </span>
              <span class="piece-title" id={`${p.id}-t`}>
                {p.label}
              </span>
            </span>
            <span class="piece-desc" id={`${p.id}-d`}>
              <span>{p.brief}</span>
              <span class="piece-more" aria-hidden="true">
                Open the page →
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 1rem;
    margin: 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 2px solid var(--accent);
  }
  @media (min-width: 600px) {
    .showcase {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .showcase {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .piece {
    --plate-ratio: 4 / 5;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--text);
    text-decoration: none;
  }
  /* Photographs keep their true colours in both themes: a dark surround, no
     dimming or re-inking (so this is not a .figure-ground plate). */
  .piece-plate {
    position: relative;
    display: block;
    aspect-ratio: var(--plate-ratio);
    overflow: hidden;
    background: #101113;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .piece-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: none;
    mix-blend-mode: normal;
  }
  .piece-kind {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: rgb(16 17 19 / 0.78);
    color: #f2f3f5;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .piece-text {
    display: block;
    padding-top: 0.65rem;
    font-family: var(--font-sans);
  }
  .piece-meta {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-faint);
  }
  .piece-meta .n {
    display: inline-block;
    min-width: 1.1rem;
    font-variant-numeric: tabular-nums;
  }
  .piece-title {
    display: block;
    margin-top: 0.1rem;
    font-family: var(--font-serif, inherit);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .piece:hover .piece-title,
  .piece:focus-visible .piece-title {
    color: var(--flow);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Devices that can hover: the description lies over the image and shows on
     hover and on keyboard focus. */
  .piece-desc {
    position: absolute;
    inset: 0 0 auto 0;
    aspect-ratio: var(--plate-ratio);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 1rem;
    border-radius: var(--radius);
    background: linear-gradient(to top, rgb(12 14 18 / 0.94) 0%, rgb(12 14 18 / 0.86) 55%, rgb(12 14 18 / 0.55) 100%);
    color: #f2f3f5;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.45;
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .piece-more {
    font-weight: 600;
    color: #c6d8f7;
  }
  .piece:hover .piece-desc,
  .piece:focus-visible .piece-desc {
    opacity: 1;
  }
  .piece:focus-visible {
    outline-offset: 4px;
  }

  /* Touch devices and phone widths: no hover, so the description is always
     shown, under the title, on the page background. */
  @media (hover: none), (max-width: 599px) {
    .piece {
      --plate-ratio: 3 / 2;
    }
    .piece-desc {
      position: static;
      aspect-ratio: auto;
      order: 3;
      padding: 0.4rem 0 0;
      background: none;
      color: var(--text-muted);
      opacity: 1;
      transition: none;
    }
    .piece-more {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .piece-desc {
      transition: none;
    }
  }
  @media print {
    .piece-desc {
      position: static;
      aspect-ratio: auto;
      padding: 0.4rem 0 0;
      background: none;
      color: #000;
      opacity: 1;
    }
  }
</style>
