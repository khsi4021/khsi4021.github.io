---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { flowVis } from "@/data/flowvis";
---

<BaseLayout
  title="Flow Visualization"
  description="Photographs and videos from ATLS 5151 Flow Visualization: Marangoni flow in milk, Chladni patterns, a torch flame on crème brûlée and a green flame."
>
  <div class="wrap pt-10 pb-16 md:pt-12">
    <header class="pb-7">
      <p class="eyebrow">ATLS 5151, Fall 2026</p>
      <h1 class="mt-2 text-[clamp(1.75rem,4vw,2.375rem)]">Flow Visualization</h1>
      <p class="mt-4 max-w-[76ch] text-lg text-muted">
        These are my images and videos from ATLS 5151 Flow Visualization, a graduate course at the University of
        Colorado Boulder. Each assignment is a photograph or video of a real flow, with a written report on the physics
        and the technique. I have also gone a step further in this class and developed CFD models for the different
        projects. The descriptions are taken from my reports. The images are also posted on
        <a href="https://www.flowvis.org/">flowvis.org</a>.
      </p>
      {/* TODO(Khalil): add the CFD results for each piece (figures, what was modelled, which solver). */}
    </header>

    <ul class="showcase" aria-label="Flow visualization pieces">
      {flowVis.map((p, i) => (
        <li>
          <a class="piece" href={`/flow-vis/${p.slug}/`} aria-labelledby={`${p.id}-t`} aria-describedby={`${p.id}-d`}>
            <span class="piece-plate">
              <Image
                src={p.media.image}
                alt={p.alt}
                widths={[360, 540, 720, 1080]}
                sizes="(min-width: 1024px) 25vw, (min-width: 600px) 50vw, 100vw"
                format="webp"
                loading={i < 2 ? "eager" : "lazy"}
              />
              {p.media.kind !== "photo" && <span class="piece-kind">Video</span>}
            </span>
            <span class="piece-cap">
              <span class="piece-meta">
                <span class="n">{i + 1}</span>
                {p.assignment}
              </span>
              <span class="piece-title" id={`${p.id}-t`}>
                {p.label}
              </span>
            </span>
            <span class="piece-drop">
              <span class="piece-drop-in">
                <span class="piece-brief" id={`${p.id}-d`}>
                  {p.brief}
                </span>
                <span class="piece-more" aria-hidden="true">
                  Open the page →
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .showcase {
    --piece-shade: rgb(22 24 29 / 0.32);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 1rem;
    margin: 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 2px solid var(--accent);
  }
  :global([data-theme="dark"]) .showcase {
    --piece-shade: rgb(0 0 0 / 0.75);
  }
  @media (min-width: 600px) {
    .showcase {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .showcase {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* The card: a square image plate with a caption bar under it. One border, a
     surface background and the same corner radius as the header buttons. */
  .piece {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }
  /* Photographs keep their true colours in both themes: a dark surround, no
     dimming or re-inking (so this is not a .figure-ground plate). */
  .piece-plate {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #101113;
    border-bottom: 1px solid var(--border);
    border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
  }
  .piece-plate :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: none;
    mix-blend-mode: normal;
  }
  .piece-kind {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: rgb(16 17 19 / 0.78);
    color: #f2f3f5;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .piece-cap {
    display: block;
    flex: none;
    padding: 0.6rem 0.75rem 0.65rem;
    font-family: var(--font-sans);
  }
  .piece-meta {
    display: block;
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--text-faint);
  }
  .piece-meta .n {
    display: inline-block;
    min-width: 1.1rem;
    font-variant-numeric: tabular-nums;
  }
  .piece-title {
    display: block;
    margin-top: 0.1rem;
    font-family: var(--font-serif, inherit);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .piece:hover .piece-title,
  .piece:focus-visible .piece-title {
    color: var(--flow);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* The description. By default (touch devices, phone widths, print) it is
     always shown, in normal flow, under the caption inside the card. */
  .piece-drop {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--text-muted);
  }
  .piece-drop-in {
    display: block;
  }
  .piece-brief {
    display: block;
    padding: 0 0.75rem 0.8rem;
  }
  .piece-more {
    display: none;
    padding: 0.5rem 0.75rem 0.8rem;
    font-weight: 600;
    color: var(--flow);
  }

  /* Devices that can hover, from two columns up: the card rests as a square
     tile and, on hover and on keyboard focus, grows downward into a vertical
     rectangle with the description under the image. The extension hangs below
     the card (absolutely positioned against the list item, raised), so neither
     the neighbouring cards nor the rest of the page move. */
  @media screen and (hover: hover) and (min-width: 600px) {
    .showcase {
      --lap: calc(var(--radius) + 1px);
      /* Room under the last row for an opened card, clear of the footer. */
      margin-bottom: 11rem;
    }
    /* The list item is the positioning box: it has no border of its own, so
       its edges are exactly the card's outer edges at any display scaling. */
    .showcase li {
      position: relative;
      z-index: 0;
      /* Closing: stay raised until the extension has folded away. */
      transition: z-index 200ms step-end;
    }
    .showcase li:hover {
      z-index: 2;
      transition: z-index 0s;
    }
    .showcase li:has(.piece:focus-visible) {
      z-index: 2;
      transition: z-index 0s;
    }
    .piece {
      transition: border-color 150ms var(--ease-out-soft);
    }
    .piece:hover,
    .piece:focus-visible {
      border-color: var(--border-strong);
    }
    .piece-drop {
      position: absolute;
      top: calc(100% - var(--lap));
      right: 0;
      left: 0;
      display: grid;
      grid-template-rows: 0fr;
      /* The top strip lies over the card's bottom edge and its rounded
         corners, so the opened card has straight sides all the way down. */
      padding-top: var(--lap);
      background: var(--surface);
      border: 1px solid;
      border-color: inherit;
      border-top: 0;
      border-radius: 0 0 var(--radius) var(--radius);
      box-shadow:
        -2px 2px 0 transparent,
        2px 2px 0 transparent,
        0 16px 24px -16px transparent;
      visibility: hidden;
      transition:
        grid-template-rows 200ms var(--ease-out-soft),
        box-shadow 200ms var(--ease-out-soft),
        visibility 200ms;
    }
    /* No padding on the clipped box itself: it has to fold to zero height. */
    .piece-drop-in {
      min-height: 0;
      overflow: hidden;
    }
    .piece-brief {
      padding-bottom: 0;
    }
    .piece-more {
      display: block;
    }
    .piece:hover .piece-drop,
    .piece:focus-visible .piece-drop {
      grid-template-rows: 1fr;
      visibility: visible;
      /* Soft shadow under the opened card only (the negative spread keeps it
         off the sides and off the caption above). */
      box-shadow:
        -2px 2px 0 transparent,
        2px 2px 0 transparent,
        0 16px 24px -16px var(--piece-shade);
    }
  }

  /* Keyboard focus on an opened card: the ring follows the whole vertical
     rectangle (card plus extension) instead of crossing it at the caption.
     The extension's part of the ring is two offset shadows, which cover its
     left, right and bottom sides and leave the top, where the caption is,
     clear. */
  @media screen and (hover: hover) and (min-width: 600px) and (forced-colors: none) {
    .piece:focus-visible {
      outline: none;
      border-color: var(--flow);
      box-shadow: 0 0 0 2px var(--flow);
    }
    .piece:focus-visible .piece-drop {
      box-shadow:
        -2px 2px 0 var(--flow),
        2px 2px 0 var(--flow),
        0 16px 24px -16px var(--piece-shade);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase li,
    .showcase li:hover,
    .showcase li:has(.piece:focus-visible),
    .piece,
    .piece-drop {
      transition: none;
    }
  }
  @media print {
    .showcase li {
      break-inside: avoid;
    }
    .piece-plate {
      print-color-adjust: exact;
    }
  }
</style>
