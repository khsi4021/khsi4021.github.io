---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Lightbox from "@/components/Lightbox.astro";
import { flowVis, type FlowVisId } from "@/data/flowvis";
import milkDye from "@/assets/flowvis/flowvis-milk-dye.jpg";
import chladniPoster from "@/assets/flowvis/flowvis-chladni-poster.jpg";
import cremeBrulee from "@/assets/flowvis/flowvis-creme-brulee.png";
import greenFlamePoster from "@/assets/flowvis/flowvis-green-flame-poster.jpg";

// How each piece is shown:
//  photo: resized image, opens in the lightbox.
//  video: poster frame plus a video file in /public/media (loaded only on play).
//  link:  poster frame that links to the flowvis.org post.
type Media =
  | { kind: "photo"; image: ImageMetadata }
  | { kind: "video"; image: ImageMetadata; src: string }
  | { kind: "link"; image: ImageMetadata; linkText: string };

const media: Record<FlowVisId, Media> = {
  "milk-dye": { kind: "photo", image: milkDye },
  // TODO(Khalil): the Chladni video is 50 MB, too large to host here. Once ffmpeg is
  // installed (winget install Gyan.FFmpeg) a compressed copy can go in
  // public/media/flowvis-chladni.mp4 and this entry can become kind: "video".
  chladni: { kind: "link", image: chladniPoster, linkText: "Watch the video on flowvis.org" },
  "creme-brulee": { kind: "photo", image: cremeBrulee },
  "green-flame": { kind: "video", image: greenFlamePoster, src: "/media/flowvis-green-flame.mp4" },
};

const pieces = await Promise.all(
  flowVis.map(async (e) => {
    const m = media[e.id];
    const full = await getImage({ src: m.image, width: Math.min(m.image.width, 2000), format: "webp" });
    return { ...e, m, full: full.src };
  }),
);
---

<BaseLayout
  title="Flow Visualization"
  description="Photographs and videos from ATLS 5151 Flow Visualization: Marangoni flow in milk, Chladni patterns, a torch flame on crème brûlée and a green flame."
>
  <div class="wrap pt-10 pb-16 md:pt-14">
    <header class="pb-10">
      <p class="eyebrow">ATLS 5151, Fall 2026</p>
      <h1 class="mt-2 text-[clamp(1.75rem,4vw,2.375rem)]">Flow Visualization</h1>
      <p class="mt-4 max-w-[68ch] text-lg text-muted">
        These are my images and videos from ATLS 5151 Flow Visualization, a graduate course at the University of
        Colorado Boulder. Each assignment is a photograph or video of a real flow, with a written report on the physics
        and the technique. The descriptions below are taken from my reports. The images are also posted on
        <a class="text-flow underline" href="https://www.flowvis.org/">
          flowvis.org
        </a>
        .
      </p>
    </header>

    {pieces.map((p, i) => (
      <section class="sec scroll-mt-8" id={p.id} aria-labelledby={`${p.id}-h`}>
        <p class="sec-label">
          <span class="n">{i + 1}</span>
          {p.label}
        </p>
        <div class="min-w-0">
          <h2 id={`${p.id}-h`} class="max-w-[30ch] text-[clamp(1.375rem,2.6vw,1.75rem)]">
            {p.title}
          </h2>
          <p class="mt-2 font-sans text-sm text-faint">
            {p.assignment} · <time datetime={p.dateISO}>{p.date}</time>
          </p>

          <figure class="mt-6 max-w-[1000px]">
            <div class="photo-plate">
              {p.m.kind === "photo" && (
                <button
                  type="button"
                  class="block w-full cursor-zoom-in"
                  data-lightbox={p.full}
                  data-lightbox-alt={p.alt}
                  aria-label={`Enlarge image: ${p.title}`}
                >
                  <Image
                    src={p.m.image}
                    alt={p.alt}
                    widths={[640, 960, 1280, Math.min(p.m.image.width, 2000)]}
                    sizes="(min-width: 1280px) 1000px, 100vw"
                    format="webp"
                    class="block h-auto w-full"
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </button>
              )}
              {p.m.kind === "video" && (
                <video
                  class="block h-auto w-full"
                  src={p.m.src}
                  poster={p.full}
                  width={p.m.image.width}
                  height={p.m.image.height}
                  controls
                  playsinline
                  preload="none"
                  aria-label={p.alt}
                >
                  <p>
                    {p.alt} <a href={p.post}>Watch the video on flowvis.org</a>.
                  </p>
                </video>
              )}
              {p.m.kind === "link" && (
                <a class="block" href={p.post} aria-label={`${p.m.linkText}: ${p.title}`}>
                  <Image
                    src={p.m.image}
                    alt={p.alt}
                    widths={[640, 960, 1280, Math.min(p.m.image.width, 2000)]}
                    sizes="(min-width: 1280px) 1000px, 100vw"
                    format="webp"
                    class="block h-auto w-full"
                    loading="lazy"
                  />
                </a>
              )}
            </div>
            <figcaption class="mt-2 font-sans text-sm text-muted">
              {p.caption}
              {p.m.kind === "link" && (
                <>
                  {" "}
                  <a class="text-flow underline" href={p.post}>
                    {p.m.linkText}
                  </a>
                  .
                </>
              )}
            </figcaption>
          </figure>

          <div class="mt-6 max-w-[68ch] space-y-4">
            {p.description.map((para) => (
              <p>{para}</p>
            ))}
            {p.pending && (
              <div class="placeholder" data-placeholder>
                <p>{p.pending}</p>
              </div>
            )}
            {p.credit && <p class="font-sans text-sm text-muted">{p.credit}</p>}
          </div>

          <table class="technique mt-6 max-w-[68ch]">
            <caption>Technique</caption>
            <tbody>
              {p.technique.map((t) => (
                <tr>
                  <th scope="row">{t.field}</th>
                  <td>{t.value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <p class="mt-5 font-sans text-sm">
            <a class="text-flow underline" href={p.post}>
              {p.label}: my post on flowvis.org
            </a>
          </p>
        </div>
      </section>
    ))}
  </div>
  <Lightbox />
</BaseLayout>

<style>
  /* Photographs keep their true colours in both themes: a dark surround, no
     dimming or re-inking (so this is not a .figure-ground plate). */
  .photo-plate {
    background: #101113;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius, 2px);
    overflow: hidden;
  }
  .photo-plate :global(img),
  .photo-plate video {
    filter: none;
    mix-blend-mode: normal;
  }
  .photo-plate button:focus-visible,
  .photo-plate a:focus-visible {
    outline-offset: -3px;
  }

  .technique {
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--text);
    border-bottom: 1px solid var(--text);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .technique caption {
    caption-side: top;
    text-align: left;
    font-weight: 600;
    color: var(--text);
    padding-bottom: 0.4rem;
  }
  .technique th,
  .technique td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
  }
  .technique tr:first-child th,
  .technique tr:first-child td {
    border-top: 0;
  }
  .technique th {
    width: 8.5rem;
    padding-right: 1rem;
    font-weight: 500;
    color: var(--text-faint);
  }
  .technique td {
    color: var(--text);
    font-variant-numeric: lining-nums;
  }
  @media (max-width: 479px) {
    .technique th {
      width: 6.25rem;
      padding-right: 0.75rem;
    }
  }
</style>
