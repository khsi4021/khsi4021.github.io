---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Figure from "@/components/Figure.astro";
import Lightbox from "@/components/Lightbox.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import PackReveal from "@/components/PackReveal.astro";
import { site, hasEmail, hasLinkedIn } from "@/data/site";

const all = (await getCollection("projects")).map((p) => p.data).sort((a, b) => a.order - b.order);
const bySlug = Object.fromEntries(all.map((d) => [d.slug, d]));

// The path: projects in frontmatter `order`, under their frontmatter `group`.
const groups: { name: string; items: typeof all }[] = [];
for (const d of all) {
  const name = d.group ?? "Other work";
  const last = groups.at(-1);
  if (last && last.name === name) last.items.push(d);
  else groups.push({ name, items: [d] });
}

// Selected results. Values are read from each project's frontmatter `metrics`
// (matched by label), so they cannot drift from the project pages.
const metric = (slug: string, label: string) => {
  const m = bySlug[slug]?.metrics.find((x) => x.label.startsWith(label));
  if (!m) throw new Error(`Home: metric "${label}" not found on project "${slug}"`);
  return m.value;
};
const results = [
  {
    value: metric("hypersonic-solver", "vs Fay–Riddell"),
    text: "Stagnation-line heating against the Fay–Riddell correlation.",
    slug: "hypersonic-solver",
    name: "Hypersonic solver",
    tab: "technical",
    type: "Personal",
  },
  {
    // Not a frontmatter metric: copied from the benchmark table on the
    // hypersonic-solver Results tab (PANT-RT row, reference roughness height).
    value: "15.30° / 10.06°",
    text: "Predicted transition onset against the source paper's Table 3, at the reference roughness height. The gap is examined on the page and is not closed.",
    slug: "hypersonic-solver",
    name: "Hypersonic solver",
    tab: "results",
    type: "Personal",
  },
  {
    value: metric("newtonian-aero", "sphere C_D"),
    text: "Sphere drag coefficient against the exact Newtonian value of 1.",
    slug: "newtonian-aero",
    name: "Newtonian aerodynamics",
    tab: "technical",
    type: "Course",
  },
  {
    value: metric("debrisolver", "max rel. error vs NASA CARA"),
    text: "Maximum relative error in collision probability against NASA CARA, over 977 cases.",
    slug: "debrisolver",
    name: "DebriSolver",
    tab: "results",
    type: "Personal · competition entry",
  },
  {
    value: metric("debrisolver", "propagated maneuvers"),
    text: "Propagated avoidance maneuvers that meet the collision-probability target.",
    slug: "debrisolver",
    name: "DebriSolver",
    tab: "results",
    type: "Personal · competition entry",
  },
  {
    value: metric("sim6dof", "ω_n error vs analytic model"),
    text: "Natural-frequency error against the analytic model, all five Boeing 747 modes.",
    slug: "sim6dof",
    name: "Sim6DOF",
    tab: "results",
    type: "Team (two people)",
  },
];

const hyper = bySlug["hypersonic-solver"];
---

<BaseLayout>
  <!-- DRAFT: Home copy. TODO(Khalil): replace the placeholder block in section 1 with your own wording,
       and check the one-sentence `contribution` lines in each project's frontmatter. -->
  <div class="wrap">
    <header class="pt-10 pb-10">
      <h1 class="text-[clamp(1.875rem,1.5rem+1.4vw,2.375rem)] leading-tight tracking-[-0.01em]">{site.name}</h1>
      <p class="mt-3 max-w-[62ch] font-sans text-[0.9375rem] leading-relaxed text-muted">
        {site.degree}. {site.minors}.
      </p>
      <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 font-sans text-[0.9375rem]">
        {hasEmail && (
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        )}
        <li>
          <a href={site.github} rel="me">
            GitHub
          </a>
        </li>
        {hasLinkedIn && (
          <li>
            <a href={site.linkedin} rel="me">
              LinkedIn
            </a>
          </li>
        )}
        <li>
          <a href="/cv/">Curriculum vitae</a>
        </li>
      </ul>
    </header>

    <section class="sec" aria-labelledby="sec-direction">
      <h2 id="sec-direction" class="sec-label">
        <span class="n">1</span>Research direction
      </h2>
      <div>
        <div class="placeholder max-w-[68ch]">
          <p>
            My research interest is computational fluid dynamics for hypersonic flow. I am applying to MS/PhD programs
            for Fall 2027. A paragraph in my own words on the research questions I want to work on will go here.
          </p>
        </div>
        <p class="mt-4 font-sans text-[0.9375rem]">
          <a href="/research/">Read the research page</a>
        </p>
      </div>
    </section>

    <section class="sec" aria-labelledby="sec-path">
      <h2 id="sec-path" class="sec-label">
        <span class="n">2</span>The path
      </h2>
      <div>
        <p class="max-w-[68ch]">
          Ordered by relevance to hypersonic CFD, not by date. Later groups are in other fields; each line says what
          carries over.
        </p>
        {groups.map((g) => (
          <div class="mt-5">
            <h3 class="font-sans text-[0.9375rem] font-semibold tracking-normal">{g.name}</h3>
            <ol class="path-list mt-2 list-none border-b border-line p-0">
              {g.items.map((d) => (
                <ProjectRow d={d} n={`2.${all.indexOf(d) + 1}`} />
              ))}
            </ol>
            {g.name === "Numerical methods" && (
              <p class="mt-3 font-sans text-[0.8125rem] text-muted">
                See also the{" "}
                <a href="/coursework/#computational-aero">
                  vortex panel method and lifting-line theory lab (ASEN 3802, team lab)
                </a>{" "}
                under Coursework.
              </p>
            )}
          </div>
        ))}
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-sans text-[0.9375rem]">
          <a href="/projects/">All {all.length} projects</a>
          <a href="/coursework/">Coursework highlights</a>
        </p>
      </div>
    </section>

    <section class="sec" aria-labelledby="sec-results">
      <h2 id="sec-results" class="sec-label">
        <span class="n">3</span>Selected results
      </h2>
      <div>
        <p class="max-w-[68ch]">
          Each number is taken from the project page it links to. Team and course work is marked as such.
        </p>
        <div class="results-scroll mt-5" role="region" aria-labelledby="sec-results" tabindex="0">
          <table class="results">
            <thead>
              <tr>
                <th scope="col">Result</th>
                <th scope="col">Project</th>
                <th scope="col">Type</th>
              </tr>
            </thead>
            <tbody>
              {results.map((r) => (
                <tr>
                  <td>
                    <span class="val">{r.value}</span>
                    <span class="what">{r.text}</span>
                  </td>
                  <td>
                    <a href={`/projects/${r.slug}/#${r.tab}`}>
                      {r.name}, {r.tab} tab
                    </a>
                  </td>
                  <td>{r.type}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <Figure src={hyper.heroImage} alt={hyper.heroAlt} maxWidth={760}>
          Laminar wall heat flux along a Mach-6 cylinder (top) and the roughness-transition parameter for three
          roughness heights (bottom). Transition is predicted where each curve crosses the threshold of 434. From the
          <a href="/projects/hypersonic-solver/">hypersonic heating and transition solver</a>.
        </Figure>
      </div>
    </section>

    <section class="sec" aria-labelledby="sec-term">
      <h2 id="sec-term" class="sec-label">
        <span class="n">4</span>Fall 2026
      </h2>
      <ul class="term list-none p-0 font-sans text-[0.9375rem]">
        <li>
          <a href="/coursework/#hypersonics">ASEN 5131 Hypersonic Aerodynamics</a> (graduate)
        </li>
        <li>
          ASEN 4018 Senior Design: <a href="/projects/aircraft-design-toolbox/">capstone UAV sizing</a> and the
          <a href="/projects/sim6dof/">Sim6DOF flight simulator</a>
        </li>
        <li>
          <a href="/flow-vis/">ATLS 5151 Flow Visualization</a> (graduate)
        </li>
      </ul>
    </section>
  </div>
  <PackReveal />
  <Lightbox />
</BaseLayout>

<style>
  /* Two projects per row on wide screens, to halve the length of the list. */
  @media (min-width: 1024px) {
    .path-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  .results-scroll {
    overflow-x: auto;
  }
  .results {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
  .results th {
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    padding: 0 1rem 0.5rem 0;
    border-bottom: 2px solid var(--accent);
  }
  .results td {
    vertical-align: top;
    padding: 0.75rem 1rem 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .results th:last-child,
  .results td:last-child {
    padding-right: 0;
  }
  .results .val {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .results .what {
    display: block;
    margin-top: 0.2rem;
    color: var(--text-muted);
    max-width: 46ch;
  }
  .term li {
    padding-block: 0.6rem;
    border-top: 1px solid var(--border);
  }
  .term li:first-child {
    border-top: 0;
    padding-top: 0;
  }
</style>
