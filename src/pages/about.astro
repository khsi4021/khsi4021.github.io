---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkillsMatrix from "@/components/SkillsMatrix.astro";
import Timeline from "@/components/Timeline.astro";
import { site } from "@/data/site";

// Dates come from the résumé (Oct 2026) and the project files. Newest first.
const timeline = [
  { when: "Fall 2027", title: "Graduate school (applying)", body: "MS/PhD in CFD and hypersonics.", todo: true },
  {
    when: "Fall 2026",
    title: "Senior design, graduate hypersonics, Flow Vis",
    body: "ASEN 4018, ASEN 5131, ATLS 5151. DebriSolver pipeline and report completed (Oct 2026).",
    href: "/projects/sim6dof/",
  },
  {
    when: "Aug 2026",
    title: "Hypersonic boundary-layer solver",
    body: "My first research-style project.",
    href: "/projects/hypersonic-solver/",
  },
  {
    when: "Spring 2026",
    title: "Scientific computing, aerodynamics labs",
    body: "PDE solvers, the vortex panel method, lifting-line theory.",
    href: "/coursework/",
  },
  {
    when: "Oct – Dec 2025",
    title: "APPM 4350: heat diffusion in 3-D geometries",
    body: "Series solutions of the heat equation for a slab, a cylinder and a sphere, in a three-person team.",
    href: "/projects/heat-diffusion-3d/",
  },
  {
    when: "Aug 2025 – Apr 2026",
    title: "Team lead, NASA RASC-AL: Project REGENESIS",
    body: "Led a 16-member team on a lunar ISRU infrastructure concept.",
    href: "/projects/rasc-al-regenesis/",
  },
  {
    when: "Jun – Nov 2025",
    title: "DebriSolver competition",
    body: "A conjunction-risk response concept for orbital debris mitigation.",
    href: "/projects/debrisolver/",
  },
  {
    when: "Jan – May 2025",
    title: "Project manager, ASEN 2804 glider team",
    body: "A 9-member team, with a dual-design approach and MATLAB configuration studies.",
    href: "#beyond",
  },
  {
    when: "Fall 2024",
    title: "Experimental & computational methods",
    body: "First simulation projects: TCAS closest approach and a water-rocket trajectory.",
    href: "/projects/bottle-rocket/",
  },
  {
    when: "Jan 2024 – now",
    title: "High-power rocketry",
    body: "Tripoli Level 1 certified; building a fiberglass, dual-deploy rocket for Level 2.",
    href: "#beyond",
  },
  {
    when: "Jan – May 2024",
    title: "Regenerative-power CubeSat payload",
    body: "A suborbital payload that reached the Kármán line, testing power generation from in-space temperature gradients.",
    href: "/projects/regen-power-cubesat/",
  },
  {
    when: "Aug 2023",
    title: "Start of the B.S. in Aerospace Engineering Sciences at CU Boulder",
    body: "First programming projects in C++.",
    href: "/projects/candy-land/",
  },
  {
    when: "Jun – Aug 2023",
    title: "Engineering intern, AGQ Labs (Bahrain)",
    body: "GIS analysis in ArcGIS of agricultural land conditions for the NEOM region in Saudi Arabia.",
  },
];

// RASC-AL, the CubeSat payload and APPM 4350 have their own project pages.
const beyond: { title: string; when: string; body: string; href?: string }[] = [
  {
    title: "Team lead, NASA RASC-AL: Project REGENESIS",
    when: "Aug 2025 – Apr 2026",
    href: "/projects/rasc-al-regenesis/",
    body: "Led a 16-member multidisciplinary team representing CU in NASA's 2025–26 RASC-AL competition, developing a lunar ISRU infrastructure concept with faculty advisors. I ran ANSYS simulations of launchpad durability under lunar-lander plume and landing loads.",
  },
  {
    title: "Regenerative-power CubeSat payload",
    when: "Jan – May 2024",
    href: "/projects/regen-power-cubesat/",
    body: "A course team's suborbital payload that reached the Kármán line to test power generation from Peltier devices and in-space temperature gradients. I estimated the power with a CFD heat-transfer simulation, ran vacuum-chamber tests with liquid-nitrogen cooling, then overlaid both on post-flight telemetry.",
  },
  {
    title: "High-power rocketry",
    when: "Jan 2024 – now",
    body: "Used OpenRocket simulations and CAD structural models to reach Tripoli Rocketry Association Level 1 certification. I'm now building a fiberglass composite rocket with dual-deploy recovery for Level 2.",
  },
  {
    title: "Project manager, ASEN 2804 glider design",
    when: "Jan – May 2025",
    body: "Elected project manager of a 9-member team. I introduced a dual-design approach (3D-printed and balsa airframes) and wrote MATLAB simulation code to compare glider configurations, then checked the results against wind-tunnel data.",
  },
  {
    title: "APPM 4350: heat diffusion in 3-D geometries",
    when: "Oct – Dec 2025",
    href: "/projects/heat-diffusion-3d/",
    body: "Derived analytical heat-equation solutions with separation of variables and eigenfunction expansions, and compared the slab case with a thermal simulation.",
  },
];

const awards = [
  "Tripoli Rocketry Association Level 1 high-power rocket certification",
  "Saudi Aramco CDPNE competition (awarded scholarship)",
  "UK Mathematics Challenge: Gold (2021), Silver (2020)",
  "Custodian of the Two Holy Mosques Scholarship Program: full scholarship",
];
---

<BaseLayout
  title="About"
  description="About Khalil Sidani: B.S. Aerospace Engineering Sciences at the University of Colorado Boulder."
>
  <!-- TODO(Khalil): the biography placeholder is waiting for your own wording; the timeline dates are waiting for your check. -->
  <article class="wrap">
    <header>
      <p class="eyebrow">About</p>
      <h1 class="mt-1 text-[clamp(1.75rem,4vw,2.375rem)]">Khalil Sidani</h1>
    </header>

    <section class="sec" aria-labelledby="bio-h">
      <h2 id="bio-h" class="sec-label">
        <span class="n">1</span>Biography
      </h2>
      <div class="max-w-[68ch]">
        <div class="placeholder" data-placeholder>
          <p>A short biography in my own words will go here.</p>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="facts-h">
      <h2 id="facts-h" class="sec-label">
        <span class="n">2</span>Education
      </h2>
      <dl class="max-w-[68ch]">
        <div class="grid gap-x-6 gap-y-0.5 border-b border-line pb-2 sm:grid-cols-[6rem_minmax(0,1fr)]">
          <dt class="font-sans text-sm text-faint sm:pt-[0.2rem]">Degree</dt>
          <dd>{site.degree}</dd>
        </div>
        <div class="grid gap-x-6 gap-y-0.5 border-b border-line py-2 sm:grid-cols-[6rem_minmax(0,1fr)]">
          <dt class="font-sans text-sm text-faint sm:pt-[0.2rem]">Minors</dt>
          <dd>{site.minors}</dd>
        </div>
        <div class="grid gap-x-6 gap-y-0.5 pt-2 sm:grid-cols-[6rem_minmax(0,1fr)]">
          <dt class="font-sans text-sm text-faint sm:pt-[0.2rem]">GPA</dt>
          <dd>
            <span class="whitespace-nowrap">
              Cumulative GPA <span class="tabular-nums">{site.gpa.cumulative}</span>
            </span>
            <span aria-hidden="true"> · </span>
            <span class="sr-only">, </span>
            <span class="whitespace-nowrap">
              Major GPA <span class="tabular-nums">{site.gpa.major}</span>
            </span>
          </dd>
        </div>
      </dl>
    </section>

    <section class="sec" aria-labelledby="long-h">
      <h2 id="long-h" class="sec-label">
        <span class="n">3</span>The long game
      </h2>
      <div class="max-w-[68ch]">
        <p>
          I want to found a company that builds commercial supersonic and hypersonic aircraft. That's a long way off.
          The first step is learning to predict and design for the aerothermal environment properly, which is why my
          research interests look the way they do.
        </p>
      </div>
    </section>

    <section id="beyond" class="sec scroll-mt-8" aria-labelledby="beyond-h">
      <h2 id="beyond-h" class="sec-label">
        <span class="n">4</span>Beyond the code
      </h2>
      <div>
        <p class="max-w-[68ch] text-muted">Leadership, hardware and team projects from my CV.</p>
        <ul class="mt-3 grid gap-x-8 border-t border-line md:grid-cols-2">
          {beyond.map((b) => (
            <li class="border-b border-line py-3">
              <p class="font-sans text-sm text-accent tabular-nums">{b.when}</p>
              <h3 class="mt-0.5 text-[1.0625rem]">{b.title}</h3>
              <p class="mt-1 font-sans text-[0.9375rem] leading-normal text-muted">{b.body}</p>
              {b.href && (
                <p class="mt-1.5 font-sans text-[0.9375rem]">
                  <a href={b.href}>
                    Project page<span class="sr-only">: {b.title}</span>
                  </a>
                </p>
              )}
            </li>
          ))}
        </ul>
        <h3 class="mt-5 font-sans text-sm font-semibold text-accent">Awards</h3>
        <ul class="mt-2 grid gap-x-8 border-t border-line font-sans text-[0.9375rem] md:grid-cols-2">
          {awards.map((a) => (
            <li class="border-b border-line py-1.5">{a}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="skills" class="sec scroll-mt-8" aria-labelledby="skills-h">
      <h2 id="skills-h" class="sec-label">
        <span class="n">5</span>Skills matrix
      </h2>
      <div>
        <SkillsMatrix />
      </div>
    </section>

    <section class="sec" aria-labelledby="timeline-h">
      <h2 id="timeline-h" class="sec-label">
        <span class="n">6</span>Timeline
      </h2>
      <div>
        <div class="placeholder max-w-[68ch]" data-placeholder>
          <p>The dates and descriptions below were taken from my CV and are waiting for me to check each one.</p>
        </div>
        <div class="mt-4">
          <Timeline items={timeline} />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
