---
// About now lives on the home page. This page only forwards old links
// (/about/, /about/#skills, /about/#beyond) to the same anchor on "/".
const home = new URL("/", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About · Khalil Sidani</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
    <script is:inline>
      location.replace("/" + location.hash);
    </script>
    <meta http-equiv="refresh" content="0; url=/" />
  </head>
  <body>
    <p>
      The About page is now part of the <a href="/">home page</a>.
    </p>
  </body>
</html>
