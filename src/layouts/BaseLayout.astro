---
import "@/styles/global.css";
import { site, nav, hasEmail, hasLinkedIn } from "@/data/site";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultOg from "@/assets/og-default.png";
// Preload the two fonts visible above the fold to limit font-swap layout shift.
import serifWoff2 from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import sansWoff2 from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
  ogAlt?: string;
  type?: "website" | "article";
}

const { title, description = site.description, ogImage, ogAlt, type = "website" } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({
  src: ogImage ?? defaultOg,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 80,
  fit: "cover",
});
const ogUrl = new URL(og.src, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") + "/";
const isActive = (href: string) => path.startsWith(href);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={serifWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? `${site.name}: ${site.positioning}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (() => {
        let t = "light";
        try {
          const s = localStorage.getItem("theme2");
          if (s === "light" || s === "dark") t = s;
        } catch {}
        const d = document.documentElement;
        d.dataset.theme = t;
        d.classList.add("js");
        // Pre-select the project tab before first paint (avoids a layout shift
        // when the tabs script hides the other panels).
        const tabs = ["overview", "technical", "results", "reflection", "code"];
        const h = location.hash.slice(1);
        d.dataset.initialTab = tabs.includes(h) ? h : "overview";
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <header class="site-header">
      <div class="wrap">
        <div class="flex items-center justify-between gap-6 py-3.5">
          <a href="/" class="no-underline">
            <span class="block font-serif text-[1.1875rem] leading-tight font-semibold">{site.name}</span>
            <span class="mt-0.5 hidden text-[0.8125rem] text-muted sm:block">
              Aerospace Engineering Sciences, University of Colorado Boulder
            </span>
          </a>
          <div class="flex items-center gap-5">
            <nav aria-label="Main" class="hidden lg:block">
              <ul class="flex items-center gap-6">
                {nav.map((n) => (
                  <li>
                    <a
                      href={n.href}
                      class:list={[
                        "site-nav-link block py-1 text-[0.9375rem] no-underline hover:text-ink",
                        isActive(n.href) ? "is-current font-semibold text-ink" : "text-muted",
                      ]}
                      aria-current={isActive(n.href) ? "page" : undefined}
                    >
                      {n.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <ThemeToggle />
            <button
              type="button"
              class="rounded-[var(--radius)] border border-line-strong px-3 py-1.5 text-[0.9375rem] text-ink lg:hidden"
              aria-controls="mobile-nav"
              aria-expanded="false"
              data-menu-button
            >
              Menu
            </button>
          </div>
        </div>
        <nav id="mobile-nav" aria-label="Main" class="hidden border-t border-line lg:hidden" data-menu>
          <ul>
            {nav.map((n) => (
              <li class="border-t border-line first:border-t-0">
                <a
                  href={n.href}
                  class:list={[
                    "block py-3 text-base no-underline",
                    isActive(n.href) ? "font-semibold text-ink" : "text-muted",
                  ]}
                  aria-current={isActive(n.href) ? "page" : undefined}
                >
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="grid gap-6 py-6 text-[0.9375rem] text-muted md:grid-cols-[1.4fr_1fr_1fr]">
          <div>
            <p class="font-serif text-base font-semibold text-ink">{site.name}</p>
            <p class="mt-1 max-w-[40ch]">{site.degree}</p>
          </div>
          <div>
            <p class="font-semibold text-ink">Contents</p>
            <ul class="mt-1.5 columns-2 gap-x-6 space-y-0.5">
              {nav.map((n) => (
                <li>
                  <a class="hover:text-flow hover:underline" href={n.href}>
                    {n.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="font-semibold text-ink">Contact</p>
            <ul class="mt-1.5 space-y-0.5">
              {hasEmail && (
                <li>
                  <a class="hover:text-flow hover:underline" href={`mailto:${site.email}`}>
                    {site.email}
                  </a>
                </li>
              )}
              <li>
                <a class="hover:text-flow hover:underline" href={site.github} rel="me">
                  GitHub
                </a>
              </li>
              {hasLinkedIn && (
                <li>
                  <a class="hover:text-flow hover:underline" href={site.linkedin} rel="me">
                    LinkedIn
                  </a>
                </li>
              )}
              <li>
                <a class="hover:text-flow hover:underline" href="/cv/">
                  Curriculum vitae
                </a>
              </li>
            </ul>
          </div>
        </div>
        <p class="border-t border-line py-3 text-[0.8125rem] text-faint">
          © {new Date().getFullYear()} {site.name}
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>("[data-menu-button]");
      const menu = document.querySelector<HTMLElement>("[data-menu]");
      btn?.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        menu?.classList.toggle("hidden", open);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") {
          btn.setAttribute("aria-expanded", "false");
          menu?.classList.add("hidden");
          btn.focus();
        }
      });
    </script>
  </body>
</html>
