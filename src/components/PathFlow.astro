---
// Flowchart of steps leading to a goal. Pure HTML/CSS: an ordered list laid out as
// three-column rows (wide) or a single column (narrow), with decorative arrows.
// Each block carries a date line, a title (optionally a link) and a one-sentence
// note on what the step adds toward the goal. Works for any number of items.
export interface PathFlowItem {
  when: string;
  title: string;
  /** One short sentence, shown under the title. */
  note?: string;
  href?: string;
  kind: "course" | "personal" | "team" | "goal";
  todo?: boolean;
}
interface Props {
  items: PathFlowItem[];
  label: string;
}
const { items, label } = Astro.props;
const COLS = 3;
const kindsUsed = (["course", "team", "personal", "goal"] as const).filter((k) => items.some((it) => it.kind === k));
const kindName = { course: "Coursework", team: "Team project", personal: "Personal project", goal: "Goal" };
---

<div class="pf">
  <ol class="pf-list" aria-label={label}>
    {items.map((it, i) => (
      <li class:list={["pf-step", `pf-${it.kind}`, { "pf-rowend": i % COLS === COLS - 1 }]}>
        <p class="pf-when">{it.when}</p>
        <p class="pf-title">
          {it.href ? <a href={it.href}>{it.title}</a> : it.title}
          {it.todo && <span class="pf-todo">(to confirm)</span>}
        </p>
        {it.note && <p class="pf-note">{it.note}</p>}
        {i < items.length - 1 && (
          <span class="pf-arrow" aria-hidden="true">
            <span class="pf-tip" />
          </span>
        )}
      </li>
    ))}
  </ol>
  <ul class="pf-legend" aria-label="Block colours">
    {kindsUsed.map((k) => (
      <li>
        <span class:list={["pf-swatch", `pf-swatch-${k}`]} aria-hidden="true" />
        {kindName[k]}
      </li>
    ))}
  </ul>
</div>

<style>
  .pf {
    container-type: inline-size;
    --pf-gap-x: 2.25rem;
    --pf-gap-y: 2.25rem;
    --pf-line: var(--border-strong);
    --pf-w: 1.5px;
  }
  .pf-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--pf-gap-y) var(--pf-gap-x);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pf-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0.875rem 0.875rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .pf-team {
    border-top-color: var(--accent);
  }
  .pf-personal {
    border-top-color: var(--accent);
    background: var(--glow);
  }
  .pf-goal {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .pf-when {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
  }
  .pf-personal .pf-when {
    color: var(--text-muted);
  }
  .pf-goal .pf-when {
    color: inherit;
  }
  .pf-title {
    font-size: var(--text-base);
    line-height: 1.3;
  }
  .pf-title a {
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 2px;
  }
  .pf-title a:hover {
    color: var(--flow);
  }
  .pf-goal .pf-title a {
    text-decoration-color: currentColor;
  }
  .pf-goal .pf-title a:hover {
    color: inherit;
    text-decoration-thickness: 2px;
  }
  .pf-todo {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
  /* What the step adds. Sans and muted so it reads as a comment on the title. */
  .pf-note {
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--text-muted);
  }
  .pf-goal .pf-note {
    color: inherit;
  }

  /* Arrows. Narrow layout: straight down, centred under each block. */
  .pf-arrow {
    position: absolute;
    left: 50%;
    top: calc(100% + 4px);
    width: var(--pf-w);
    height: calc(var(--pf-gap-y) - 7px);
    background: var(--pf-line);
    pointer-events: none;
  }
  .pf-tip {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 8px;
    height: 8px;
    border-right: var(--pf-w) solid var(--pf-line);
    border-bottom: var(--pf-w) solid var(--pf-line);
    transform: translateX(-50%) rotate(45deg);
  }

  /* Wide layout: three per row, arrows pointing right, an elbow from the end of one row to the start of the next. */
  @container (min-width: 38rem) {
    .pf-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pf-arrow {
      left: calc(100% + 4px);
      top: 50%;
      width: calc(var(--pf-gap-x) - 7px);
      height: var(--pf-w);
      transform: translateY(-50%);
    }
    .pf-tip {
      left: auto;
      right: 0;
      top: 50%;
      bottom: auto;
      transform: translateY(-50%) rotate(-45deg);
    }
    .pf-rowend .pf-arrow {
      left: auto;
      right: 50%;
      top: calc(100% + 3px);
      width: calc(200% + 2 * var(--pf-gap-x) + 2px);
      height: calc(var(--pf-gap-y) - 6px);
      background: none;
      transform: none;
    }
    .pf-rowend .pf-arrow::before {
      content: "";
      position: absolute;
      inset: 0 0 50% 0;
      border-right: var(--pf-w) solid var(--pf-line);
      border-bottom: var(--pf-w) solid var(--pf-line);
    }
    .pf-rowend .pf-arrow::after {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      bottom: 0;
      border-left: var(--pf-w) solid var(--pf-line);
    }
    .pf-rowend .pf-tip {
      left: calc(var(--pf-w) / 2);
      right: auto;
      top: auto;
      bottom: 0;
      transform: translateX(-50%) rotate(45deg);
    }
  }

  .pf-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .pf-legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .pf-swatch {
    width: 1rem;
    height: 0.75rem;
    border: 1px solid var(--border);
    border-top: 3px solid var(--border-strong);
    background: var(--surface);
    border-radius: var(--radius-sm);
  }
  .pf-swatch-team {
    border-top-color: var(--accent);
  }
  .pf-swatch-personal {
    border-top-color: var(--accent);
    background: var(--glow);
  }
  .pf-swatch-goal {
    border-color: var(--accent);
    background: var(--accent);
  }

  @media print {
    .pf-step {
      break-inside: avoid;
    }
  }
</style>
