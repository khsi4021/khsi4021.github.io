---
interface Props {
  items: { value: string; label: string; href?: string }[];
  class?: string;
}
const { items, class: cls } = Astro.props;
---

<dl class:list={["readouts flex flex-wrap gap-2.5", cls]}>
  {items.map((m) => (
    <div class="flex flex-[1_1_150px] flex-col-reverse justify-end rounded-[var(--radius)] border border-line bg-surface px-4 py-3.5 shadow-[var(--shadow-card)]">
      <dt class="mono-label mt-1.5 leading-snug">{m.label}</dt>
      <dd class="text-[1.625rem] leading-none font-semibold tracking-[-0.03em] text-ink tabular-nums">
        {m.href ? (
          <a href={m.href} class="no-underline hover:text-accent">
            {m.value}
          </a>
        ) : (
          m.value
        )}
      </dd>
    </div>
  ))}
</dl>
