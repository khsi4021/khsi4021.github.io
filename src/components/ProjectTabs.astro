---
// Accessible tabs (WAI-ARIA tabs pattern, automatic activation).
// Without JS, every panel is shown in order and the tablist stays hidden.
// Deep links: #overview, #technical, #results, #reflection, #code, or any id
// inside a panel (the panel containing it is selected).
import { TAB_LABELS, type TabId } from "@/data/tabs";

interface Props {
  tabs: TabId[];
}
const { tabs } = Astro.props;
---

<div data-tabs>
  <div class="js-only no-print sticky top-[4.5rem] z-30 -mx-4 bg-bg/85 px-4 py-2 backdrop-blur-md md:mx-0 md:px-0">
    <div
      role="tablist"
      aria-label="Project sections"
      class="flex w-max max-w-full gap-1 overflow-x-auto overflow-y-hidden rounded-full border border-line bg-surface p-[5px]"
      data-tablist
    >
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t}`}
          aria-controls={t}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="tab-btn"
          data-tab={t}
        >
          {TAB_LABELS[t]}
        </button>
      ))}
    </div>
  </div>
  <div class="pt-6">
    <slot />
  </div>
</div>

<style>
  [data-tablist] {
    scrollbar-width: none;
  }
  [data-tablist]::-webkit-scrollbar {
    display: none;
  }
  .tab-btn {
    padding: 0.45rem 1rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 150ms,
      background-color 150ms;
  }
  .tab-btn:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .tab-btn[aria-selected="true"] {
    color: var(--accent-ink);
    background: var(--accent);
  }
  .tab-btn:focus-visible {
    outline-offset: 1px;
  }
</style>

<script>
  function initTabs(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls")!)!).filter(Boolean);
    const tablist = root.querySelector<HTMLElement>("[data-tablist]")!;

    // Number figures and equations in document order before any panel is hidden.
    root.querySelectorAll<HTMLElement>("figure.figure").forEach((f, i) => {
      const n = f.querySelector<HTMLElement>(".fig-num");
      if (n) n.textContent = `Fig. ${i + 1}`;
      f.dataset.num = String(i + 1);
    });
    document.documentElement.classList.add("figs-numbered");

    const select = (id: string, opts: { focus?: boolean; updateHash?: boolean; scroll?: boolean } = {}) => {
      const idx = tabs.findIndex((t) => t.dataset.tab === id);
      if (idx < 0) return;
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (opts.focus) tabs[idx].focus();
      if (opts.updateHash) history.replaceState(null, "", `#${id}`);
      if (opts.scroll) {
        const top = root.getBoundingClientRect().top + window.scrollY - 72;
        if (window.scrollY > top) window.scrollTo({ top });
      }
      tabs[idx].scrollIntoView({ block: "nearest", inline: "nearest" });
      document.dispatchEvent(new CustomEvent("tabshown", { detail: id }));
    };

    const fromHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (!h) return false;
      if (tabs.some((t) => t.dataset.tab === h)) {
        select(h, { scroll: false });
        requestAnimationFrame(() => {
          const top = root.getBoundingClientRect().top + window.scrollY - 72;
          window.scrollTo({ top });
        });
        return true;
      }
      const target = document.getElementById(h);
      const panel = target?.closest<HTMLElement>('[role="tabpanel"]');
      if (panel) {
        select(panel.id);
        requestAnimationFrame(() => target!.scrollIntoView());
        return true;
      }
      return false;
    };

    tablist.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (b) select(b.dataset.tab!, { updateHash: true, scroll: true });
    });
    tablist.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      let j = -1;
      if (e.key === "ArrowRight") j = (i + 1) % tabs.length;
      else if (e.key === "ArrowLeft") j = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === "Home") j = 0;
      else if (e.key === "End") j = tabs.length - 1;
      if (j >= 0) {
        e.preventDefault();
        select(tabs[j].dataset.tab!, { focus: true, updateHash: true });
      }
    });
    // In-page links such as <a href="#results"> or "see Fig. 3"
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a || a.closest("[data-tablist]")) return;
      const id = a.getAttribute("href")!.slice(1);
      if (!id) return;
      const isTab = tabs.some((t) => t.dataset.tab === id);
      const inPanel = document.getElementById(id)?.closest('[role="tabpanel"]');
      if (isTab || inPanel) {
        e.preventDefault();
        history.replaceState(null, "", `#${id}`);
        fromHash();
      }
    });
    window.addEventListener("hashchange", fromHash);
    if (!fromHash()) select(tabs[0].dataset.tab!);
    document.documentElement.dataset.tabsReady = "1";
  }

  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(initTabs);
</script>
