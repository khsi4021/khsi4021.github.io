---
// Project details as an unboxed definition list with hairline rules.
import fs from "node:fs";
import path from "node:path";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}
const d = Astro.props.project.data;

// A report served from public/ as a PDF gets its file size in the label, read at build time.
function pdfSize(href: string): string | undefined {
  if (!href.startsWith("/") || !href.toLowerCase().endsWith(".pdf")) return undefined;
  try {
    const bytes = fs.statSync(path.join(process.cwd(), "public", decodeURI(href))).size;
    return `${(bytes / 1e6).toFixed(1)} MB`;
  } catch {
    return undefined;
  }
}

type Link = { href: string; label: string; pdf?: boolean };
const report = d.links.report;
const reportSize = report ? pdfSize(report) : undefined;
const isPdf = !!report && report.toLowerCase().endsWith(".pdf");
const links = [
  d.links.repo && { href: d.links.repo, label: "Repository" },
  report && {
    href: report,
    label: isPdf ? `Final report (PDF${reportSize ? `, ${reportSize}` : ""})` : "Report",
    pdf: isPdf,
  },
  d.links.video && { href: d.links.video, label: "Video" },
  d.links.demo && { href: d.links.demo, label: "Demo" },
].filter(Boolean) as Link[];
---

<aside class="meta-sidebar" aria-label="Project details">
  <dl>
    <div class="meta-row">
      <dt>Type</dt>
      <dd>{d.context ? `${d.type} · ${d.context}` : d.type}</dd>
    </div>
    <div class="meta-row">
      <dt>Dates</dt>
      <dd>{d.dates}</dd>
    </div>
    {d.course && (
      <div class="meta-row">
        <dt>{d.type === "Course" || !d.context ? "Course" : "Built for"}</dt>
        <dd>{d.course}</dd>
      </div>
    )}
    {d.team && (
      <div class="meta-row">
        <dt>Team</dt>
        <dd>{d.team}</dd>
      </div>
    )}
    <div class="meta-row">
      <dt>Role</dt>
      <dd>{d.role}</dd>
    </div>
    <div class="meta-row">
      <dt>Methods and tools</dt>
      <dd>{d.stack.join(", ")}</dd>
    </div>
    <div class="meta-row">
      <dt>Topics</dt>
      <dd>{d.tags.map((t, i) => [i > 0 ? ", " : "", <a href={`/projects/?tag=${encodeURIComponent(t)}`}>{t}</a>])}</dd>
    </div>
    <div class="meta-row">
      <dt>Status</dt>
      <dd class="capitalize">{d.status}</dd>
    </div>
    {links.length > 0 && (
      <div class="meta-row">
        <dt>Links</dt>
        <dd>
          {links.map((l) =>
            l.pdf ? (
              <span class="block">
                <a href={l.href} type="application/pdf" target="_blank" rel="noopener">
                  {l.label}
                </a>
                <span class="text-faint"> · </span>
                <a href={l.href} download>
                  Download
                </a>
              </span>
            ) : (
              <a class="block" href={l.href}>
                {l.label}
              </a>
            ),
          )}
        </dd>
      </div>
    )}
  </dl>
</aside>

<style>
  .meta-sidebar {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
  dl {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    border-top: 2px solid var(--accent);
  }
  .meta-row {
    display: contents;
  }
  dt,
  dd {
    margin: 0;
    border-bottom: 1px solid var(--border);
    padding-block: 0.5rem;
    line-height: 1.45;
  }
  dt {
    padding-top: 0.6rem;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-faint);
  }
  dd {
    color: var(--text);
  }
  dd a {
    color: var(--flow);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  dd a:hover {
    text-decoration-thickness: 2px;
  }
  @media (min-width: 1024px) {
    dl {
      display: block;
    }
    .meta-row {
      display: block;
      border-bottom: 1px solid var(--border);
      padding-block: 0.7rem;
    }
    dt,
    dd {
      border: 0;
      padding: 0;
    }
    dd {
      margin-top: 0.15rem;
    }
  }
</style>
