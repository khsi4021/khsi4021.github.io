---
// Looping simulation video. Plays when scrolled into view (never with
// prefers-reduced-motion) and pauses when hidden. In dark mode the frames are
// re-inked like figures (unless keepInk is set, for colour-mapped videos);
// native controls would be inverted too, so a small Play/Pause button
// (outside the filtered element) replaces them.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string; // file in /public, e.g. "/media/tsunami.mp4"
  poster: ImageMetadata;
  alt: string;
  source?: string;
  id?: string;
  /** Colour-mapped video: keep the original colours on a paper card in dark mode. */
  keepInk?: boolean;
}
const { src, poster, alt, source, id, keepInk = false } = Astro.props;
const p = await getImage({ src: poster, width: Math.min(poster.width, 1280), format: "webp" });
---

<figure class="figure wide my-8" id={id}>
  <div
    class:list={[
      "figure-ground relative overflow-hidden rounded-[var(--radius-lg)] border border-line",
      keepInk && "keep-ink",
    ]}
    data-video
  >
    <video
      class:list={[!keepInk && "reink", "block h-auto w-full"]}
      src={src}
      poster={p.src}
      muted
      loop
      playsinline
      preload="none"
      aria-label={alt}
      data-autoplay-in-view
    >
      <p>{alt}</p>
    </video>
    <button
      type="button"
      class="js-only absolute right-3 bottom-3 rounded-full border border-line bg-surface-2/90 px-3 py-1 font-mono text-xs text-ink backdrop-blur hover:border-accent"
      data-video-toggle
      aria-label="Play video"
    >
      Play
    </button>
  </div>
  <figcaption class="mt-3 text-sm leading-relaxed text-muted">
    <span class="fig-num font-mono text-xs tracking-wide text-accent"></span>
    <slot />
    {source && <span class="mono-label mt-1 block">Source: {source}</span>}
  </figcaption>
</figure>

<style>
  figcaption :global(> p) {
    display: inline;
  }
  .fig-num:not(:empty)::after,
  :global(html:not(.figs-numbered)) .fig-num::after {
    content: "  ";
    white-space: pre;
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((box) => {
    const v = box.querySelector<HTMLVideoElement>("video")!;
    const b = box.querySelector<HTMLButtonElement>("[data-video-toggle]")!;
    let userPaused = reduce;
    const sync = () => {
      const playing = !v.paused;
      b.textContent = playing ? "Pause" : "Play";
      b.setAttribute("aria-label", playing ? "Pause video" : "Play video");
    };
    v.addEventListener("play", sync);
    v.addEventListener("pause", sync);
    b.addEventListener("click", () => {
      if (v.paused) {
        userPaused = false;
        v.play().catch(() => {});
      } else {
        userPaused = true;
        v.pause();
      }
    });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting && !userPaused) v.play().catch(() => {});
          else if (!e.isIntersecting) v.pause();
        },
        { threshold: 0.4 },
      ).observe(v);
    }
    sync();
  });
</script>
