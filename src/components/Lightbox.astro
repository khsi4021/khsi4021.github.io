---
// One shared <dialog> for every figure on the page. Native dialog gives us
// focus trapping, Esc to close and focus return. The image is always shown
// undimmed on a white plate, in both themes.
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Enlarged figure">
  <form method="dialog" class="flex justify-end">
    <button class="btn h-9 px-3 py-1 text-sm" aria-label="Close enlarged figure">
      Close
    </button>
  </form>
  <div class="lightbox-plate mt-3 overflow-auto border border-line p-3">
    <img alt="" data-lightbox-img class="mx-auto h-auto max-h-[80vh] w-auto max-w-full" />
  </div>
  <p class="mt-3 max-w-[90ch] font-sans text-sm text-muted" data-lightbox-caption></p>
</dialog>

<style>
  .lightbox {
    width: min(96vw, 1500px);
    max-width: none;
    max-height: 96vh;
    margin: auto;
    padding: 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgb(12 14 18 / 0.72);
  }
  /* Always pure white, also in dark mode: the enlarged figure is the original. */
  .lightbox-plate {
    border-radius: var(--radius-sm);
    background: #ffffff;
    color: #1a1a1a;
  }
  .lightbox[open] {
    animation: lb-in 150ms ease-out;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  const img = dlg?.querySelector<HTMLImageElement>("[data-lightbox-img]");
  const cap = dlg?.querySelector<HTMLElement>("[data-lightbox-caption]");
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-lightbox]");
    if (!btn || !dlg || !img || !cap) return;
    img.src = btn.dataset.lightbox!;
    img.alt = btn.dataset.lightboxAlt ?? "";
    const fc = btn.closest("figure")?.querySelector("figcaption");
    cap.textContent = fc?.textContent?.replace(/\s+/g, " ").trim() ?? "";
    dlg.showModal();
  });
  dlg?.addEventListener("click", (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>
