---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface GalleryItem {
  title: string;
  technique: string;
  caption: string;
  image?: ImageMetadata;
  alt?: string;
}
interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;
const fulls = await Promise.all(
  items.map((it) =>
    it.image ? getImage({ src: it.image, width: Math.min(it.image.width, 2200), format: "webp" }) : null,
  ),
);
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((it, i) => (
    <li class="card overflow-hidden">
      <figure>
        {it.image ? (
          <button
            type="button"
            class="block w-full cursor-zoom-in"
            data-lightbox={fulls[i]!.src}
            data-lightbox-alt={it.alt}
            aria-label={`Enlarge: ${it.title}`}
          >
            <Image
              src={it.image}
              alt={it.alt ?? it.title}
              width={800}
              height={800}
              fit="cover"
              class="aspect-square w-full object-cover"
              loading="lazy"
            />
          </button>
        ) : (
          <div
            class="placeholder grid aspect-square place-items-center p-6 text-center"
            role="img"
            aria-label={`Placeholder for ${it.title}`}
          >
            <div>
              <p class="mono-label">Image coming soon</p>
              <p class="mt-2 font-display text-lg text-muted">{it.title}</p>
            </div>
          </div>
        )}
        <figcaption class="p-4">
          <p class="font-medium">{it.title}</p>
          <p class="mono-label mt-0.5">{it.technique}</p>
          <p class="mt-2 text-sm text-muted">{it.caption}</p>
        </figcaption>
      </figure>
    </li>
  ))}
</ul>

<style>
  .placeholder {
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        color-mix(in srgb, var(--border) 55%, transparent) 14px 15px
      ),
      var(--surface-2);
  }
</style>
