---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import TypeBadge from "./TypeBadge.astro";
import { nbHyphen } from "@/utils/text";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}
const { project, headingLevel = "h3", eager = false } = Astro.props;
const d = project.data;
const H = headingLevel;
---

<article
  class="tile group flex h-full flex-col !p-3 transition-[border-color,transform] duration-200 ease-[var(--ease-out-soft)] hover:-translate-y-0.5 hover:border-accent motion-reduce:hover:translate-y-0"
  data-project
  data-tags={d.tags.join("|")}
  data-type={d.type}
>
  <div
    class:list={["figure-ground relative aspect-[16/10] overflow-hidden rounded-xl", d.thumbnailKeepInk && "keep-ink"]}
  >
    <Image
      src={d.thumbnail}
      alt={d.thumbnailAlt}
      width={640}
      height={400}
      fit="cover"
      position="center"
      loading={eager ? "eager" : "lazy"}
      class:list={[!d.thumbnailKeepInk && "reink", "h-full w-full object-cover object-center"]}
    />
    <TypeBadge type={d.type} class="absolute top-2.5 left-2.5 z-[3]" />
  </div>
  <div class="flex flex-1 flex-col px-1.5 pt-3.5 pb-2">
    <span class="mono-label">{d.dates}</span>
    <H class="mt-1.5 text-lg leading-snug">
      <a href={`/projects/${d.slug}/`} class="no-underline after:absolute after:inset-0 after:z-[4] after:content-['']">
        {nbHyphen(d.title)}
      </a>
    </H>
    <p class="mt-1.5 text-sm text-muted">{d.hook}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-4" aria-label="Tags">
      {d.tags.map((t) => (
        <li class="chip">{t}</li>
      ))}
    </ul>
  </div>
</article>
