---
// Interactive pole map for the Sim6DOF B747 benchmark (Observable Plot,
// lazy-loaded). A static table with the same numbers is always rendered.
import data from "@/data/sim6dof-modes.json";
const modes = [...new Set(data.rows.map((r) => r.mode))];
const fmt = (n: number, d = 4) => (Number.isFinite(n) ? n.toFixed(d) : "–");
---

<div
  class="island pole-map my-8 overflow-hidden rounded-[var(--radius-lg)] border border-line bg-surface"
  data-pole-map
>
  <div class="flex flex-wrap gap-1.5 border-b border-line px-4 py-3" role="group" aria-label="Mode">
    {modes.map((m, i) => (
      <button type="button" class="seg" data-mode={m} aria-pressed={i === 0 ? "true" : "false"}>
        {m}
      </button>
    ))}
  </div>
  <div class="paper js-only min-h-[360px] p-3" data-plot aria-hidden="true"></div>
  <div class="overflow-x-auto border-t border-line">
    <table class="w-full text-sm">
      <caption class="sr-only">Eigenvalues by mode and source</caption>
      <thead>
        <tr class="text-left">
          <th class="mono-label px-4 py-2 font-normal">Source</th>
          <th class="mono-label px-3 py-2 font-normal">Re (1/s)</th>
          <th class="mono-label px-3 py-2 font-normal">Im (rad/s)</th>
          <th class="mono-label px-3 py-2 font-normal">
            ω<sub>n</sub> (rad/s)
          </th>
          <th class="mono-label px-3 py-2 font-normal">ζ</th>
        </tr>
      </thead>
      {modes.map((m, i) => (
        <tbody data-mode-rows={m} data-first={i === 0 ? "" : undefined}>
          {data.rows
            .filter((r) => r.mode === m)
            .map((r) => (
              <tr class="border-t border-line">
                <td class="px-4 py-1.5">{r.source}</td>
                <td class="px-3 py-1.5 font-mono tabular-nums">{fmt(r.re)}</td>
                <td class="px-3 py-1.5 font-mono tabular-nums">{fmt(r.im)}</td>
                <td class="px-3 py-1.5 font-mono tabular-nums">{fmt(r.wn)}</td>
                <td class="px-3 py-1.5 font-mono tabular-nums">{fmt(r.zeta, 3)}</td>
              </tr>
            ))}
        </tbody>
      ))}
    </table>
  </div>
  <p class="mono-label border-t border-line px-4 py-2">
    Source: projects/sim6dof-simulator/results/benchmark_summary.csv. "Last year's sim" has no roll or spiral entries.
  </p>
</div>

<style>
  .seg {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: transparent;
    cursor: pointer;
  }
  .seg:hover {
    color: var(--text);
  }
  .seg[aria-pressed="true"] {
    color: var(--text);
    border-color: var(--flow);
    background: color-mix(in srgb, var(--flow) 12%, transparent);
  }
</style>

<script>
  import data from "@/data/sim6dof-modes.json";
  const root = document.querySelector<HTMLElement>("[data-pole-map]");
  if (root) {
    // Without JS all rows stay visible; with JS only the selected mode's rows show.
    const palette: Record<string, string> = {
      "Etkin textbook": "#1a1a1a",
      "Analytic (same data)": "#2B7BD6",
      "Sim6DOF (frozen atm)": "#E8673A",
      "Sim6DOF (ISA)": "#16A37B",
      "Last year's sim": "#7B4FC4",
    };
    const symbols: Record<string, string> = {
      "Etkin textbook": "square",
      "Analytic (same data)": "diamond",
      "Sim6DOF (frozen atm)": "circle",
      "Sim6DOF (ISA)": "times",
      "Last year's sim": "triangle",
    };
    let mode = data.rows[0].mode;
    const host = root.querySelector<HTMLElement>("[data-plot]")!;
    let Plot: typeof import("@observablehq/plot") | null = null;

    const draw = () => {
      if (!Plot) return;
      const rows = data.rows.filter((r) => r.mode === mode && Number.isFinite(r.re));
      const xs = rows.map((r) => r.re);
      const ys = rows.map((r) => r.im);
      const pad = (a: number[]) => {
        const lo = Math.min(...a, 0),
          hi = Math.max(...a, 0);
        const d = (hi - lo || Math.abs(hi) || 1) * 0.15;
        return [lo - d, hi + d];
      };
      const w = host.clientWidth || 640;
      const chart = Plot.plot({
        width: w,
        height: Math.max(320, Math.min(440, w * 0.55)),
        marginLeft: 64,
        marginBottom: 44,
        style: {
          background: "transparent",
          color: "#1a1a1a",
          fontFamily: "Inter Variable, sans-serif",
          fontSize: "13px",
        },
        x: { label: "Real (1/s) →", domain: pad(xs), grid: true, tickFormat: (d: number) => d.toPrecision(2) },
        y: { label: "↑ Imag (rad/s)", domain: pad(ys), grid: true, tickFormat: (d: number) => d.toPrecision(2) },
        color: { domain: Object.keys(palette), range: Object.values(palette), legend: true },
        symbol: { domain: Object.keys(symbols), range: Object.values(symbols) },
        marks: [
          Plot.ruleX([0], { stroke: "#888", strokeDasharray: "3,3" }),
          Plot.ruleY([0], { stroke: "#bbb" }),
          Plot.dot(rows, {
            x: "re",
            y: "im",
            stroke: "source",
            symbol: "source",
            r: 7,
            strokeWidth: 2,
            tip: true,
            title: (d: (typeof rows)[number]) =>
              `${d.source}\nλ = ${d.re.toFixed(5)} ${d.im >= 0 ? "+" : "−"} ${Math.abs(d.im).toFixed(5)}i\nωn = ${d.wn.toFixed(4)} rad/s, ζ = ${d.zeta.toFixed(3)}`,
          }),
        ],
      });
      host.replaceChildren(chart);
    };

    const select = (m: string) => {
      mode = m;
      root
        .querySelectorAll<HTMLButtonElement>("[data-mode]")
        .forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === m)));
      root.querySelectorAll<HTMLElement>("[data-mode-rows]").forEach((t) => (t.hidden = t.dataset.modeRows !== m));
      draw();
    };
    root.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-mode]");
      if (b) select(b.dataset.mode!);
    });
    select(mode);

    new IntersectionObserver(async (entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      Plot = await import("@observablehq/plot");
      draw();
      new ResizeObserver(() => draw()).observe(host);
    }).observe(root);
    document.addEventListener("tabshown", () => draw());
  }
</script>
