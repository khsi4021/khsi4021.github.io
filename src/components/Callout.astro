---
// A left-ruled note. The label text states the tone, so colour is not the only cue.
interface Props {
  tone?: "note" | "honest" | "todo";
  title?: string;
}
const { tone = "note", title } = Astro.props;
const styles = {
  note: { bar: "var(--border-strong)", label: "Note" },
  honest: { bar: "var(--text)", label: "Known gap" },
  todo: { bar: "var(--accent)", label: "To confirm" },
}[tone];
---

<aside class="callout my-6 border-l-2 py-1 pl-4" style={`border-left-color:${styles.bar}`}>
  <p class="font-sans text-[0.8125rem] font-semibold text-ink">{title ?? styles.label}</p>
  <div class="mt-1 font-sans text-[0.9375rem] leading-normal text-muted [&_strong]:text-ink [&>*+*]:mt-2">
    <slot />
  </div>
</aside>
