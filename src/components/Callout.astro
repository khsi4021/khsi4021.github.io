---
interface Props {
  tone?: "note" | "honest" | "todo";
  title?: string;
}
const { tone = "note", title } = Astro.props;
const styles = {
  note: { bar: "var(--flow)", label: "Note" },
  honest: { bar: "var(--accent)", label: "Known gap" },
  todo: { bar: "var(--warn)", label: "To confirm" },
}[tone];
---

<aside
  class="callout my-6 rounded-r-[var(--radius)] border border-l-2 border-line bg-surface px-4 py-3 text-[0.9375rem]"
  style={`border-left-color:${styles.bar}`}
>
  <p class="mono-label mb-1" style={`color:${styles.bar}`}>
    {title ?? styles.label}
  </p>
  <div class="text-muted [&>*+*]:mt-2 [&_strong]:text-ink">
    <slot />
  </div>
</aside>
