---
// Project type as a small sans label with a hairline box. One neutral style
// for all four types: the type is a category, not a status.
interface Props {
  type: "Personal" | "Course" | "Team" | "Competition";
  class?: string;
}
const { type, class: cls } = Astro.props;
---

<span class:list={["type-badge", cls]}>{type}</span>

<style>
  .type-badge {
    display: inline-block;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0 0.4rem;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
