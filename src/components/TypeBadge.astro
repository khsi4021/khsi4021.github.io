---
// Project type as a small sans label with a hairline box. One neutral style
// for every type: the type is a category, not a status. An optional context
// (e.g. "competition entry") follows the type after a middle dot.
import type { TYPES } from "@/content.config";

interface Props {
  type: (typeof TYPES)[number];
  context?: string;
  class?: string;
}
const { type, context, class: cls } = Astro.props;
---

<span class:list={["type-badge", cls]}>{context ? `${type} · ${context}` : type}</span>

<style>
  .type-badge {
    display: inline-block;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0 0.4rem;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
