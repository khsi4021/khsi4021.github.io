---
// Project type as a small sans label with a hairline box. One neutral style
// for every type: the type is a category, not a status. An optional context
// (e.g. "Competition") is printed as a second badge of the same size next to
// it, tinted with the accent so it reads as a secondary tag. The context is a
// label only; it is not a filter.
import type { TYPES } from "@/content.config";

interface Props {
  type: (typeof TYPES)[number];
  context?: string;
  class?: string;
}
const { type, context, class: cls } = Astro.props;
---

{context ? (
  <span class:list={["type-badges", cls]}>
    <span class="type-badge">{type}</span>
    <span class="sr-only">, </span>
    <span class="type-badge type-badge-context">{context}</span>
  </span>
) : (
  <span class:list={["type-badge", cls]}>{type}</span>
)}

<style>
  .type-badges {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
  }
  .type-badge {
    display: inline-block;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0 0.4rem;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .type-badge-context {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background: var(--glow);
    color: var(--accent);
  }
</style>
