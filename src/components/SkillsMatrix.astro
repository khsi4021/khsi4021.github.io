---
import { skillMatrix } from "@/data/skills";
// Compact matrix: one block per group, each skill on one line followed by the
// pages where it is shown. Groups flow into two columns from 768 px.
---

<p class="font-sans text-sm text-muted">Each skill links to the pages where it is shown.</p>
<dl class="skills mt-2 border-t-2 border-accent font-sans text-sm leading-snug">
  {skillMatrix.map((g) => (
    <div class="skills-group">
      <dt class="font-semibold text-accent">{g.group}</dt>
      <dd class="m-0">
        <ul class="mt-1 list-none p-0">
          {g.skills.map((s) => (
            <li class="py-[0.1875rem]">
              <span class="text-ink">{s.name}</span>
              <span class="text-faint" aria-hidden="true">
                {" "}
                ·{" "}
              </span>
              <span class="sr-only">, shown in: </span>
              {s.where.map((w, j) => [j > 0 ? ", " : "", <a href={w.href}>{w.label}</a>])}
            </li>
          ))}
        </ul>
      </dd>
    </div>
  ))}
</dl>

<style>
  .skills-group {
    break-inside: avoid;
    border-bottom: 1px solid var(--border);
    padding-block: 0.5rem 0.4375rem;
  }
  @media (min-width: 768px) {
    .skills {
      columns: 2;
      column-gap: 2rem;
    }
  }
</style>
