---
// Card-pack reveal. For every project marked as a pack (see src/scripts/pack-reveal.ts)
// this renders one hidden dialog: a foil pack that tears open and a collectible
// card built from the project's own frontmatter (thumbnail, title, type, metrics).
// Links carrying data-pack="<slug>" open it on a plain click; without JS, with
// reduced motion, or on a modified click they are ordinary links.
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { isPack } from "@/scripts/pack-reveal";

const packs = (await getCollection("projects")).map((p) => p.data).filter(isPack);

// "ASEN 5131 Hypersonic Aerodynamics (graduate), ..." -> code + course name.
const courseParts = (course?: string) => {
  const m = course?.match(/^([A-Z]{2,5} \d{3,4})\s+([^(,]+)/);
  return m ? { code: m[1], name: m[2].trim() } : undefined;
};

// Zigzag edges for the foil seals (clip-path polygons, in %).
const teeth = 26;
const zig = (y0: number, y1: number, reverse = false) => {
  const pts: string[] = [];
  for (let i = 0; i <= teeth * 2; i++) {
    const x = (i / (teeth * 2)) * 100;
    pts.push(`${x.toFixed(2)}% ${i % 2 === 0 ? y0 : y1}%`);
  }
  return reverse ? pts.reverse() : pts;
};
const flapClip = `polygon(${[...zig(9, 0), "100% 100%", "0% 100%"].join(",")})`;
const bodyClip = `polygon(${[...zig(1.3, 0), ...zig(98.8, 100, true)].join(",")})`;
---

{packs.map((d) => {
  const c = courseParts(d.course);
  const href = `/projects/${d.slug}/`;
  const typeLine = [`${d.type} project`, c?.code].filter(Boolean).join(" · ");
  return (
    <div
      class="pack-overlay"
      data-pack-dialog={d.slug}
      role="dialog"
      aria-modal="true"
      aria-label={`Card pack: ${d.title}`}
      hidden
    >
      <div class="pack-backdrop" data-pack-close />
      <button type="button" class="pack-x" data-pack-close aria-label="Close and go back to the list">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>

      <div class="pack-col">
        <div class="pack-stage" data-pack-stage>
          <div class="pack-glow" aria-hidden="true" />

          <a class="pcard" href={href} data-pack-card tabindex="-1" aria-label={`Open project: ${d.title}`}>
            <span class="pcard-tilt" data-pack-tilt>
              <span class="pcard-side pcard-back" aria-hidden="true">
                <span class="back-frame">
                  <svg class="back-mark" viewBox="0 0 120 120" aria-hidden="true">
                    <path d="M86 12C44 30 44 90 86 108" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <path d="M92 34a26 26 0 0 0 0 52z" fill="currentColor" opacity="0.85" />
                    <path
                      d="M8 60h34M14 44h24M14 76h24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      opacity="0.6"
                    />
                  </svg>
                </span>
              </span>
              <span class="pcard-side pcard-face">
                <span class="face-inner">
                  <span class="face-type">{typeLine}</span>
                  <span class:list={["face-plate", "figure-ground", d.thumbnailKeepInk && "keep-ink"]}>
                    <Image
                      src={d.thumbnail}
                      alt={d.thumbnailAlt}
                      width={560}
                      loading="lazy"
                      class:list={[!d.thumbnailKeepInk && "reink"]}
                    />
                  </span>
                  <span class="face-title">{d.title}</span>
                  <span class="face-stats">
                    {d.metrics.slice(0, 3).map((m) => (
                      <span class="stat">
                        <span class="stat-label">{m.label}</span>
                        <span class="stat-value">{m.value}</span>
                      </span>
                    ))}
                  </span>
                </span>
                <span class="face-glare" aria-hidden="true" />
              </span>
            </span>
          </a>

          <div class="pack" aria-hidden="true">
            <div class="pack-body" style={`clip-path:${bodyClip}`}>
              <div class="foil" />
              <div class="sweep" />
              <div class="crimp crimp-b" />
              <div class="pack-label">
                <svg class="label-mark" viewBox="0 0 120 120" aria-hidden="true">
                  <path d="M86 12C44 30 44 90 86 108" fill="none" stroke="currentColor" stroke-width="1.5" />
                  <path d="M92 34a26 26 0 0 0 0 52z" fill="currentColor" opacity="0.85" />
                  <path
                    d="M8 60h34M14 44h24M14 76h24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    opacity="0.6"
                  />
                </svg>
                {c ? (
                  <>
                    <span class="label-code">{c.code}</span>
                    <span class="label-rule" />
                    <span class="label-name">{c.name}</span>
                  </>
                ) : (
                  <span class="label-name">{d.type} project</span>
                )}
              </div>
            </div>
            <div class="pack-flap" style={`clip-path:${flapClip}`}>
              <div class="foil" />
              <div class="crimp" />
            </div>
            <div class="pack-strip">
              <span class="strip-tab" />
            </div>
          </div>
        </div>

        <div class="pack-actions">
          <a class="pack-skip" href={href} data-pack-skip>
            Skip
          </a>
          <a class="pack-go" href={href} data-pack-go tabindex="-1">
            Open project
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M3 8h9M8.5 4.5L12 8l-3.5 3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  );
})}

<script>
  import { initPackReveal } from "@/scripts/pack-reveal";
  initPackReveal();
</script>

<style>
  /* Everything here animates transform and opacity only. */
  .pack-overlay {
    /* Time from click to the settled card; keep in step with REVEAL_MS in pack-reveal.ts. */
    --pack-t: 2.6s;
    /* Card height: fits phones and short windows, with room for the card to
       rise out of the pack and for the button underneath. */
    --ch: min(30rem, 100svh - 13rem, 76vw * 1.42);
    --pack-blue: #1b3f7a;
    --pack-blue-hi: #2a59a6;
    --pack-blue-lo: #0f2649;
    --pack-ink: #eef3fc;
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    overflow: hidden;
    overscroll-behavior: contain;
    touch-action: none;
    font-family: var(--font-sans);
    -webkit-tap-highlight-color: transparent;
  }
  .pack-overlay[hidden] {
    display: none;
  }
  .pack-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 45%, rgb(14 25 50 / 0.93), rgb(6 9 16 / 0.96));
    opacity: 0;
  }
  .is-open .pack-backdrop {
    animation: pk-fade 260ms ease-out both;
  }

  .pack-x {
    position: absolute;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    color: var(--pack-ink);
    cursor: pointer;
  }
  .pack-x:hover {
    background: rgb(255 255 255 / 0.16);
  }

  .pack-col {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    pointer-events: none;
  }
  .pack-stage {
    position: relative;
    height: var(--ch);
    aspect-ratio: 1 / 1.42;
    perspective: 1100px;
    pointer-events: auto;
    cursor: pointer;
  }

  /* --- glow behind the card ------------------------------------------ */
  .pack-glow {
    position: absolute;
    inset: -32%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(150 190 255 / 0.55), rgb(90 140 235 / 0.22) 45%, transparent 72%);
    opacity: 0;
    pointer-events: none;
  }
  .is-open .pack-glow {
    animation: pk-glow var(--pack-t) linear both;
  }

  /* --- the pack --------------------------------------------------------- */
  .pack {
    position: absolute;
    inset: -4%;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 18px 28px rgb(0 0 0 / 0.5));
  }
  .is-open .pack {
    animation: pk-pack var(--pack-t) linear both;
  }
  .pack-body,
  .pack-flap {
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    background: linear-gradient(
      100deg,
      var(--pack-blue-lo) 0%,
      var(--pack-blue) 22%,
      var(--pack-blue-hi) 48%,
      var(--pack-blue) 72%,
      var(--pack-blue-lo) 100%
    );
  }
  .pack-body {
    top: 11.5%;
    bottom: 0;
  }
  .pack-flap {
    top: 0;
    height: 12.5%;
    transform-origin: 100% 100%;
  }
  .is-open .pack-flap {
    animation: pk-flap var(--pack-t) linear both;
  }
  /* Slow holographic wash: a large conic gradient turning under the label. */
  .foil {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 240%;
    aspect-ratio: 1;
    margin: -120% 0 0 -120%;
    background: conic-gradient(
      from 0deg,
      rgb(120 200 255 / 0),
      rgb(120 210 255 / 0.3),
      rgb(190 150 255 / 0.22),
      rgb(120 200 255 / 0),
      rgb(140 255 220 / 0.2),
      rgb(255 190 230 / 0.16),
      rgb(120 200 255 / 0)
    );
    mix-blend-mode: screen;
    animation: pk-spin 7s linear infinite;
  }
  /* One bright band crossing the foil. */
  .sweep {
    position: absolute;
    inset: 0 -60%;
    background: linear-gradient(104deg, transparent 42%, rgb(255 255 255 / 0.34) 50%, transparent 58%);
    animation: pk-sweep 1.5s ease-in-out infinite;
  }
  .crimp {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      90deg,
      rgb(255 255 255 / 0.16) 0 1px,
      transparent 1px 4px,
      rgb(0 0 0 / 0.16) 4px 5px,
      transparent 5px 8px
    );
  }
  .crimp-b {
    top: auto;
    height: 7.5%;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }
  .pack-flap .crimp {
    border-bottom: 1px solid rgb(0 0 0 / 0.25);
  }
  .pack-label {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 74%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--ch) * 0.022);
    padding: calc(var(--ch) * 0.05) calc(var(--ch) * 0.03);
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 3px;
    background: rgb(10 24 50 / 0.42);
    color: var(--pack-ink);
    text-align: center;
  }
  .label-mark {
    width: calc(var(--ch) * 0.2);
    height: calc(var(--ch) * 0.2);
    color: #cfe0ff;
  }
  .label-code {
    font-family: var(--font-mono);
    font-size: calc(var(--ch) * 0.04);
    letter-spacing: 0.14em;
  }
  .label-rule {
    width: 2.5rem;
    height: 1px;
    background: rgb(255 255 255 / 0.55);
  }
  .label-name {
    font-family: var(--font-display);
    font-size: calc(var(--ch) * 0.05);
    font-weight: 600;
    line-height: 1.2;
  }
  /* Tear strip along the seam between seal and body. */
  .pack-strip {
    position: absolute;
    left: -1%;
    right: -1%;
    top: 11.3%;
    height: 1.7%;
    background: linear-gradient(180deg, #f3f6fc, #b9c8e6 55%, #8ea4cf);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.3);
  }
  .strip-tab {
    position: absolute;
    left: -4.5%;
    top: -70%;
    width: 7%;
    height: 240%;
    border-radius: 2px;
    background: linear-gradient(180deg, #f3f6fc, #9fb3da);
  }
  .is-open .pack-strip {
    animation: pk-strip var(--pack-t) linear both;
  }

  /* --- the card --------------------------------------------------------- */
  .pcard {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    color: inherit;
    text-decoration: none;
    transform-style: preserve-3d;
    transform: translateY(2%) scale(0.76) rotateY(180deg);
    pointer-events: none;
    outline: none;
  }
  .is-open .pcard {
    animation: pk-card var(--pack-t) linear both;
  }
  .is-revealed .pcard {
    pointer-events: auto;
  }
  .pcard-tilt {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 420ms var(--ease-out-soft);
  }
  .pcard-tilt.is-tilting {
    transition-duration: 90ms;
  }
  .pcard-side {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: calc(var(--ch) * 0.035);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 22px 44px rgb(0 0 0 / 0.5);
  }
  .pcard:focus-visible .pcard-side {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  .pcard-back {
    transform: rotateY(180deg);
    padding: 4.5%;
    background: linear-gradient(135deg, var(--pack-blue-hi), var(--pack-blue) 45%, var(--pack-blue-lo));
  }
  .back-frame {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: calc(var(--ch) * 0.02);
    background:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.07) 0 1px, transparent 1px 9px),
      repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.07) 0 1px, transparent 1px 9px);
    color: #cfe0ff;
  }
  .back-mark {
    width: 38%;
  }

  /* Foil border: the face is a gradient plate, the content sits on an inset panel. */
  .pcard-face {
    container-type: inline-size;
    padding: calc(var(--ch) * 0.02);
    background: linear-gradient(
      135deg,
      #7fa2e0 0%,
      #e9f0fd 16%,
      #5a82cc 34%,
      #c9b8f2 50%,
      #dff5ee 62%,
      #4f79c6 80%,
      #e3ebfb 100%
    );
  }
  .face-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 4.5cqw 4.5cqw 4cqw;
    border-radius: calc(var(--ch) * 0.02);
    background: var(--surface);
    color: var(--text);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.14);
  }
  .face-type {
    display: flex;
    align-items: center;
    gap: 2cqw;
    font-size: clamp(0.6875rem, 4.1cqw, 0.875rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent);
  }
  .face-type::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .face-plate {
    position: relative;
    display: block;
    flex: 1;
    min-height: 0;
    margin-top: 3cqw;
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .face-plate :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .face-title {
    display: block;
    margin-top: 3.4cqw;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 5.7cqw, 1.25rem);
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
  }
  .face-stats {
    display: block;
    margin-top: 3.4cqw;
    border-top: 2px solid var(--accent);
  }
  .stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 3cqw;
    padding-block: 1.7cqw;
    border-bottom: 1px solid var(--border);
  }
  .stat:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .stat-label {
    font-size: clamp(0.6875rem, 3.9cqw, 0.8125rem);
    line-height: 1.25;
    color: var(--text-muted);
  }
  .stat-value {
    flex: none;
    font-family: var(--font-mono);
    font-size: clamp(0.875rem, 5.2cqw, 1.125rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  /* Glare: an oversized soft highlight that slides with the pointer; on touch
     screens it stays put and crosses the card once at the reveal. */
  .face-glare {
    position: absolute;
    inset: -60%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.5), rgb(190 215 255 / 0.16) 45%, transparent 70%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transform: translate(var(--gx, -22%), var(--gy, -26%));
    transition:
      transform 420ms var(--ease-out-soft),
      opacity 420ms;
    pointer-events: none;
  }
  .is-revealed .face-glare {
    opacity: 1;
  }
  .is-tilting .face-glare {
    transition-duration: 90ms;
  }

  /* --- controls --------------------------------------------------------- */
  .pack-actions {
    display: grid;
    place-items: center;
    position: relative;
    z-index: 3;
    min-height: 2.75rem;
    pointer-events: auto;
  }
  .pack-actions > * {
    grid-area: 1 / 1;
  }
  .pack-skip,
  .pack-go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      opacity 260ms,
      transform 260ms var(--ease-out-soft),
      background-color 150ms;
  }
  .pack-skip {
    padding: 0 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    color: #d5def0;
    opacity: 0;
  }
  .is-open .pack-skip {
    opacity: 1;
  }
  .pack-skip:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .pack-go {
    padding: 0 1.4rem;
    border: 1px solid #ffffff;
    background: #ffffff;
    color: #14315f;
    opacity: 0;
    transform: translateY(0.5rem);
    visibility: hidden;
  }
  .pack-go:hover {
    background: #dfe9fb;
  }
  .is-revealed .pack-skip {
    opacity: 0;
    visibility: hidden;
  }
  .is-revealed .pack-go {
    opacity: 1;
    transform: none;
    visibility: visible;
  }
  .pack-overlay :is(.pack-x, .pack-skip, .pack-go):focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  /* A click on the pack while it opens jumps every animation to its end state. */
  .pack-overlay.is-fast :is(.pack, .pack-flap, .pack-strip, .pcard, .pack-glow) {
    animation-duration: 1ms;
  }

  /* --- keyframes (percentages of --pack-t) -------------------------------
     0-9 pack arrives, 12-34 shakes, 33-46 strip tears, 44-58 flap lifts,
     55-72 card rises, 60-80 pack drops away, 72-100 card flips and settles. */
  @keyframes pk-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes pk-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes pk-sweep {
    from {
      transform: translateX(-70%);
    }
    to {
      transform: translateX(70%);
    }
  }
  @keyframes pk-pack {
    0% {
      opacity: 0;
      transform: translateY(8%) scale(0.7);
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    9% {
      opacity: 1;
      transform: translateY(0) scale(0.8);
    }
    12% {
      transform: translateY(0) scale(0.8) rotate(0deg);
    }
    15.5% {
      transform: translateY(0) scale(0.8) rotate(-2.2deg);
    }
    19% {
      transform: translateY(0) scale(0.81) rotate(2.4deg);
    }
    22.5% {
      transform: translateY(0) scale(0.8) rotate(-2.6deg);
    }
    26% {
      transform: translateY(0) scale(0.81) rotate(2deg);
    }
    30% {
      transform: translateY(0) scale(0.8) rotate(-1deg);
    }
    34% {
      transform: translateY(0) scale(0.8) rotate(0deg);
    }
    60% {
      opacity: 1;
      transform: translateY(0) scale(0.8);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.6);
    }
    73% {
      opacity: 1;
      transform: translateY(34%) scale(0.8) rotate(-2deg);
      animation-timing-function: linear;
    }
    80%,
    100% {
      opacity: 0;
      transform: translateY(58%) scale(0.8) rotate(-3deg);
    }
  }
  @keyframes pk-strip {
    0%,
    33% {
      opacity: 1;
      transform: none;
      animation-timing-function: cubic-bezier(0.5, 0, 0.3, 1);
    }
    44% {
      opacity: 1;
      transform: translateX(96%) rotate(5deg);
    }
    48%,
    100% {
      opacity: 0;
      transform: translateX(118%) translateY(40%) rotate(14deg);
    }
  }
  @keyframes pk-flap {
    0%,
    44% {
      opacity: 1;
      transform: none;
      animation-timing-function: cubic-bezier(0.3, 0, 0.3, 1);
    }
    51% {
      opacity: 1;
      transform: translateY(-18%) rotate(13deg);
      animation-timing-function: ease-in;
    }
    58%,
    100% {
      opacity: 0;
      transform: translate(14%, -190%) rotate(28deg);
    }
  }
  @keyframes pk-card {
    0%,
    55% {
      transform: translateY(2%) scale(0.76) rotateY(180deg);
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
